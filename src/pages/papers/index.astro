---
import { paletteForPath } from '../../lib/palettes';
import Aurora from '../../components/Aurora.astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import StructuredData from '../../components/StructuredData.astro';
import { formatAuthors } from '../../lib/authors';
import { paperPdf } from '../../lib/badges';
import { getSiteSettings, listPapers } from '../../lib/portfolio-data';
import { publicationSchema } from '../../lib/structured-data';

// Newest first. Not grouped under year headings any more: each card carries its
// own year, so a heading above it would say the same thing twice.
const [papers, settings] = await Promise.all([listPapers(), getSiteSettings()]);
papers.sort((a, b) => b.year - a.year);
const SOCIAL = settings.social;

const KIND_LABELS: Record<string, string> = {
	journal: 'Journal',
	conference: 'Conference',
	patent: 'Patent',
	thesis: 'Thesis',
	preprint: 'Preprint',
};

const totalCitations = papers.reduce((sum, p) => sum + (p.citations ?? 0), 0);

// Each author line tidied and the owner picked out, once, for the card and
// for the structured data alike.
const entries = papers.map((paper) => ({
	paper,
	authors: formatAuthors(paper.authors, settings.siteTitle),
}));

// The section's colour, set on <html> so the stylesheet can key on it.
const paletteName = paletteForPath(Astro.url.pathname).name;
---

<!doctype html>
<html lang="en" data-palette={paletteName}>
	<head>
		<BaseHead
			title={`Papers | ${settings.siteTitle}`}
			description="Peer-reviewed publications and patents in computer vision, robotics, and applied AI."
		/>
		{
			entries.map(({ paper, authors }) => (
				<StructuredData
					data={publicationSchema(
						paper,
						authors.map((author) => author.name),
						Astro.site!,
					)}
				/>
			))
		}
	</head>
	<body>
		<Aurora />
		<Header />
		<main id="main" class="wrap">
			<header class="page-header">
				<p class="eyebrow">Research</p>
				<h1>Papers</h1>
				<p class="page-lede">
					Peer-reviewed publications and patents in computer vision, robotics, and applied AI.
				</p>

				{
					/*
					 * The publication count is gone: the list below it is the
					 * count, and stating it turns a small number into a claim.
					 * The citation total stays, since nothing else on the page
					 * says it — and the block now hangs on that alone, or it
					 * would render an empty list once the count went.
					 */
					totalCitations > 0 && (
						<dl class="stats">
							<div>
								<dt>Citations</dt>
								<dd>{totalCitations}</dd>
							</div>
						</dl>
					)
				}

				{
					SOCIAL.scholar && (
						<p class="scholar-link">
							<a href={SOCIAL.scholar} target="_blank" rel="noopener noreferrer">
								View on Google Scholar &rarr;
							</a>
						</p>
					)
				}
			</header>

			{
				papers.length > 0 ? (
					<ol class="paper-list">
						{entries.map(({ paper, authors }) => (
							<li class="paper">
								{paper.tags.length > 0 && (
									<div class="tags">
										{paper.tags.map((tag: string) => (
											<span class="tag">{tag}</span>
										))}
									</div>
								)}

								<h2 class="paper-title">
									{paper.url ? (
										<a href={paper.url} target="_blank" rel="noopener noreferrer">
											{paper.title}
										</a>
									) : (
										paper.title
									)}
								</h2>

								<p class="authors">
									{authors.map((author, index) => (
										<>
											{index > 0 && ', '}
											{author.self ? <strong>{author.name}</strong> : author.name}
										</>
									))}
								</p>
								<p class="venue">{paper.venue}</p>

								<div class="paper-tags">
									<span class="year-badge">{paper.year}</span>
									<span class="kind">{KIND_LABELS[paper.kind] ?? paper.kind}</span>
								</div>

								{paper.abstract && <p class="abstract">{paper.abstract}</p>}

								<p class="paper-meta">
									{paperPdf(paper.pdf) && (
										<a class="pdf-link" href={paper.pdf} target="_blank" rel="noopener noreferrer">
											<svg viewBox="0 0 16 16" aria-hidden="true" width="13" height="13">
												<path
													d="M4 1.5h5L12.5 5v9.5H4z"
													fill="none"
													stroke="currentColor"
													stroke-linejoin="round"
												/>
												<path d="M9 1.5V5h3.5" fill="none" stroke="currentColor" stroke-linejoin="round" />
												<path
													d="M5.8 11.6V8.9h1a.85.85 0 0 1 0 1.7h-1M8.9 11.6V8.9h.6a1.35 1.35 0 0 1 0 2.7h-.6Z"
													fill="none"
													stroke="currentColor"
													stroke-linecap="round"
												/>
											</svg>
											PDF
										</a>
									)}
									{paper.doi && (
										<a
											href={`https://doi.org/${paper.doi}`}
											target="_blank"
											rel="noopener noreferrer"
										>
											DOI: {paper.doi}
										</a>
									)}
									{typeof paper.citations === 'number' && paper.citations > 0 && (
										<span class="citations">Cited by {paper.citations}</span>
									)}
								</p>
							</li>
						))}
					</ol>
				) : (
					<p class="empty">No publications listed yet.</p>
				)
			}

		</main>
		<Footer />

		<style>
			.page-header {
				max-width: 620px;
				padding: 3rem 0 3rem;
			}

			.eyebrow {
				margin: 0 0 0.75rem;
				font-family: var(--font-mono);
				font-size: 0.75rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--color-ink-muted);
			}

			.page-header h1 {
				margin: 0 0 0.85rem;
				font-size: 2.5rem;
				letter-spacing: -0.025em;
			}

			.page-lede {
				margin: 0;
				font-size: 1.0625rem;
				font-weight: 300;
				line-height: 1.6;
				color: var(--color-ink-soft);
			}

			.stats {
				display: flex;
				gap: 2.5rem;
				margin: 1.75rem 0 0;
			}

			.stats dt {
				font-family: var(--font-mono);
				font-size: 0.6875rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--color-ink-muted);
			}

			.stats dd {
				margin: 0.15rem 0 0;
				font-size: 1.5rem;
				font-weight: 600;
				letter-spacing: -0.02em;
			}

			.scholar-link {
				margin: 1.25rem 0 0;
				font-size: 0.875rem;
			}

			.scholar-link a {
				color: var(--color-ink-muted);
				text-decoration: none;
			}

			.scholar-link a:hover {
				color: var(--color-ink);
			}

			.paper-list {
				list-style: none;
				margin: 0 0 3rem;
				padding: 0;
				display: grid;
				gap: 1.25rem;
			}

			/* A card each, matching the projects and posts listings. */
			.paper {
				background: var(--color-paper);
				border: 1px solid var(--color-sand-200);
				border-radius: 10px;
				box-shadow: var(--shadow-card);
				padding: 1.25rem 1.4rem 1.35rem;
				transition:
					box-shadow 0.2s ease,
					border-color 0.2s ease;
			}

			.paper:hover {
				box-shadow: var(--shadow-card-hover);
				border-color: var(--color-sand-300);
			}

			/* Below the venue now, so the space goes above it rather than below. */
			.paper-tags {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				margin-top: 0.7rem;
			}

			/* The year leads, so the reader places the work before reading what
			   kind of thing it is. Both are bubbles; the year is the stronger of
			   the two because it is the one that orders the list. */
			.year-badge,
			.kind {
				font-family: var(--font-mono);
				font-size: 0.6875rem;
				letter-spacing: 0.04em;
				border-radius: 999px;
				padding: 0.2rem 0.6rem;
				white-space: nowrap;
			}

			.year-badge {
				color: var(--color-ink);
				background: var(--color-sand-200);
				border: 1px solid var(--color-sand-300);
				font-weight: 500;
			}

			.kind {
				text-transform: uppercase;
				color: var(--color-ink-muted);
				background: var(--color-sand-100);
				border: 1px solid var(--color-sand-200);
			}

			.paper-title {
				margin: 0 0 0.35rem;
				font-size: 1.0625rem;
				font-weight: 600;
				line-height: 1.35;
				letter-spacing: -0.01em;
			}

			.paper-title a {
				color: inherit;
				text-decoration: none;
			}

			.paper-title a:hover {
				text-decoration: underline;
			}

			.authors {
				margin: 0 0 0.3rem;
				font-size: 0.875rem;
				color: var(--color-ink-soft);
			}

			/* The owner, on every line, is what a reader scanning the list is
			   looking for. */
			.authors strong {
				font-weight: 600;
				color: var(--color-ink);
			}

			.venue {
				margin: 0;
				font-size: 0.875rem;
				font-style: italic;
				color: var(--color-ink-muted);
			}

			/* Leading the card now, so the space goes below rather than above.
			   Rounded rather than the square chips used elsewhere, to match the
			   year and kind bubbles further down the same card. */
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin-bottom: 0.75rem;
			}

			/* Blue rather than sand, and a step up in size: the tags lead the card
			   now, so they carry more weight than the year and kind bubbles
			   further down. The blue is the site's link colour at low opacity,
			   so it belongs to the palette rather than introducing a new one. */
			.tags :global(.tag) {
				border-radius: 999px;
				padding: 0.22rem 0.65rem;
				font-size: 0.75rem;
				color: var(--color-lavender-deep);
				background: rgb(107 115 209 / 9%);
				border: 1px solid rgb(107 115 209 / 22%);
			}

			.abstract {
				margin: 0.6rem 0 0;
				font-size: 0.9375rem;
				line-height: 1.6;
				color: var(--color-ink-soft);
			}

			.paper-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
				margin: 0.75rem 0 0;
				font-family: var(--font-mono);
				font-size: 0.75rem;
				color: var(--color-ink-muted);
			}

			.paper-meta a {
				color: var(--color-ink-muted);
				text-decoration: none;
				border-bottom: 1px solid var(--color-sand-200);
			}

			.paper-meta a:hover {
				color: var(--color-ink);
			}

			/* The PDF is the one link that hands over the paper itself, so it
			   carries an icon and reads a shade darker than the DOI beside it. */
			.pdf-link {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				color: var(--color-ink-soft);
			}

			.empty {
				padding-bottom: 3rem;
				color: var(--color-ink-muted);
			}

			@media (max-width: 720px) {
				.page-header {
					padding: 2rem 0 2rem;
				}
				.page-header h1 {
					font-size: 1.875rem;
				}
			}
		</style>
	</body>
</html>
