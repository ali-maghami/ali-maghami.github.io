---
import { getCollection, render } from 'astro:content';
import Aurora from '../../components/Aurora.astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { assertBadge } from '../../lib/badges';

const entries = (await getCollection('certificates')).sort(
	(a, b) => b.data.issueDate.valueOf() - a.data.issueDate.valueOf(),
);

// The CMS offers a Notes field on every certificate, so render it. Rendering is
// async, so it is resolved up front rather than inside the template.
const certificates = await Promise.all(
	entries.map(async (entry) => ({
		...entry,
		Notes: (await render(entry)).Content,
		badge: assertBadge(entry.data.badge),
	})),
);

const now = new Date();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Certificates | Ali Maghami"
			description="Professional certifications and credentials."
		/>
	</head>
	<body>
		<Aurora />
		<Header />
		<main class="wrap">
			<header class="page-header">
				<p class="eyebrow">Credentials</p>
				<h1>Certificates</h1>
				<p class="page-lede">Professional certifications and training credentials.</p>
			</header>

			{
				certificates.length > 0 ? (
					<ul class="cert-list">
						{certificates.map((cert) => {
							const expired = cert.data.expiryDate && cert.data.expiryDate < now;
							return (
								<li class="cert-row">
									{cert.badge && (
										<img
											class="cert-badge"
											src={cert.badge}
											alt=""
											width="125"
											height="125"
											loading="lazy"
											decoding="async"
										/>
									)}
									<div class="cert-main">
										<h2 class="cert-name">
											{cert.data.url ? (
												<a href={cert.data.url} target="_blank" rel="noopener noreferrer">
													{cert.data.name}
												</a>
											) : (
												cert.data.name
											)}
										</h2>
										<p class="cert-issuer">{cert.data.issuer}</p>
										{cert.data.credentialId && (
											<p class="cert-id">ID: {cert.data.credentialId}</p>
										)}
										<div class="cert-notes">
											<cert.Notes />
										</div>
									</div>
									<div class="cert-dates">
										<FormattedDate date={cert.data.issueDate} />
										{cert.data.expiryDate && (
											<span class:list={['expiry', { expired }]}>
												{expired ? 'Expired' : 'Expires'}{' '}
												<FormattedDate date={cert.data.expiryDate} />
											</span>
										)}
									</div>
								</li>
							);
						})}
					</ul>
				) : (
					<p class="empty">No certificates listed yet.</p>
				)
			}
		</main>
		<Footer />

		<style>
			.page-header {
				max-width: 620px;
				padding: 3rem 0 3rem;
			}

			.eyebrow {
				margin: 0 0 0.75rem;
				font-family: var(--font-mono);
				font-size: 0.75rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--color-ink-muted);
			}

			.page-header h1 {
				margin: 0 0 0.85rem;
				font-size: 2.5rem;
				letter-spacing: -0.025em;
			}

			.page-lede {
				margin: 0;
				font-size: 1.0625rem;
				font-weight: 300;
				line-height: 1.6;
				color: var(--color-ink-soft);
			}

			.cert-list {
				list-style: none;
				margin: 0 0 3rem;
				padding: 0;
				border-top: 1px solid var(--color-sand-200);
			}

			.cert-row {
				display: flex;
				align-items: center;
				gap: 0.5rem 1.25rem;
				flex-wrap: wrap;
				padding: 1.15rem 0;
				border-bottom: 1px solid var(--color-sand-200);
			}

			/* Shown at the badge's native 125px. Twice that is requested from the
			   image pipeline so it stays sharp on dense screens; Astro will not
			   upscale past the source, so a smaller upload simply gets what it
			   has. */
			.cert-badge {
				width: 125px;
				height: 125px;
				object-fit: contain;
				flex-shrink: 0;
			}

			.cert-main {
				flex: 1;
				min-width: 12rem;
			}

			.cert-notes {
				font-size: 0.875rem;
				color: var(--color-ink-muted);
			}

			.cert-notes :global(p) {
				margin: 0.35rem 0 0;
			}

			.cert-name {
				margin: 0 0 0.2rem;
				font-size: 1rem;
				font-weight: 600;
				letter-spacing: -0.01em;
			}

			.cert-name a {
				color: inherit;
				text-decoration: none;
			}

			.cert-name a:hover {
				text-decoration: underline;
			}

			.cert-issuer {
				margin: 0;
				font-size: 0.875rem;
				color: var(--color-ink-soft);
			}

			.cert-id {
				margin: 0.2rem 0 0;
				font-family: var(--font-mono);
				font-size: 0.6875rem;
				color: var(--color-ink-muted);
			}

			.cert-dates {
				display: flex;
				flex-direction: column;
				align-items: flex-end;
				gap: 0.15rem;
				font-family: var(--font-mono);
				font-size: 0.75rem;
				color: var(--color-ink-muted);
				text-align: right;
			}

			.expiry.expired {
				color: var(--color-ink-muted);
				text-decoration: line-through;
			}

			.empty {
				padding-bottom: 3rem;
				color: var(--color-ink-muted);
			}

			@media (max-width: 720px) {
				.page-header {
					padding: 2rem 0 2rem;
				}
				.page-header h1 {
					font-size: 1.875rem;
				}
				.cert-dates {
					align-items: flex-start;
					text-align: left;
				}
			}
		</style>
	</body>
</html>
