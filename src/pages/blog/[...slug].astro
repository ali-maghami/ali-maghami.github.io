---
import BlogPost from '../../layouts/BlogPost.astro';
import { renderPortfolioMarkdown } from '../../lib/markdown';
import { getPostBySlug } from '../../lib/portfolio-data';

const slug = Astro.params.slug;
const post = slug ? await getPostBySlug(slug) : undefined;
if (!post) return Astro.redirect('/404');
const bodyHtml = await renderPortfolioMarkdown(post.bodyMarkdown);
---

<BlogPost {...post}>
	<Fragment set:html={bodyHtml} />
</BlogPost>
