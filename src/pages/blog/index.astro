---
import Aurora from '../../components/Aurora.astro';
import BaseHead from '../../components/BaseHead.astro';
import PostCard from '../../components/PostCard.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { assertHeroMedia, assertPortrait } from '../../lib/badges';
import { getNavHref } from '../../lib/nav';
import { getHomePage, getSiteSettings, listPosts } from '../../lib/portfolio-data';

// The contributor avatar lives on the home entry, where the portrait is set.
const [home, settings, posts] = await Promise.all([getHomePage(), getSiteSettings(), listPosts()]);
const portrait = assertPortrait(home.portrait);

posts.sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Posts | ${settings.siteTitle}`}
			description="Notes and articles on computer vision, robotics, and applied AI."
		/>
	</head>
	<body>
		<Aurora />
		<Header />
		<main class="wrap">
			<header class="page-header">
				<p class="eyebrow">Writing</p>
				<h1>Posts</h1>
				<p class="page-lede">
					Notes, walkthroughs, and things worth writing down from work in computer vision, robotics,
					and applied AI.
				</p>
			</header>

			{
				posts.length > 0 ? (
					<div class="grid">
						{posts.map((post) => (
							<PostCard
								href={getNavHref(`/blog/${post.id}/`)}
								kind={post.kind}
								title={post.title}
								description={post.description}
								date={post.pubDate}
								avatar={portrait}
								heroImage={assertHeroMedia(post.heroImage)}
								heroVideo={assertHeroMedia(post.heroVideo)}
								heroVideoPlayback={post.heroVideoPlayback}
							/>
						))}
					</div>
				) : (
					<p class="empty">No posts published yet.</p>
				)
			}
		</main>
		<Footer />

		<style>
			.page-header {
				max-width: 620px;
				padding: 3rem 0 3.5rem;
			}

			.eyebrow {
				margin: 0 0 0.75rem;
				font-family: var(--font-mono);
				font-size: 0.75rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--color-ink-muted);
			}

			.page-header h1 {
				margin: 0 0 0.85rem;
				font-size: 2.5rem;
				letter-spacing: -0.025em;
			}

			.page-lede {
				margin: 0;
				font-size: 1.0625rem;
				font-weight: 300;
				line-height: 1.6;
				color: var(--color-ink-soft);
			}

			/* Two per row, stated rather than inferred: auto-fill picks a count
			   from whatever floor it is given, which is how widening the page
			   once produced narrower cards. One column below 760px, where two
			   would leave neither enough room. */
			.grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1.25rem;
				align-items: start;
				padding-bottom: 3rem;
			}

			.empty {
				padding-bottom: 3rem;
				color: var(--color-ink-muted);
			}

			@media (max-width: 760px) {
				.grid {
					grid-template-columns: 1fr;
				}
			}

			@media (max-width: 720px) {
				.page-header {
					padding: 2rem 0 2.5rem;
				}
				.page-header h1 {
					font-size: 1.875rem;
				}
			}
		</style>
	</body>
</html>
