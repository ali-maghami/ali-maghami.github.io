---
import { getCollection } from 'astro:content';
import Aurora from '../../components/Aurora.astro';
import BaseHead from '../../components/BaseHead.astro';
import PostCard from '../../components/PostCard.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { assertHeroMedia } from '../../lib/badges';
import { getNavHref, isPublished } from '../../lib/nav';

const posts = (await getCollection('blog'))
	.filter(isPublished)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Posts | Ali Maghami"
			description="Notes and articles on computer vision, robotics, and applied machine learning."
		/>
	</head>
	<body>
		<Aurora />
		<Header />
		<main class="wrap wrap-wide">
			<header class="page-header">
				<p class="eyebrow">Writing</p>
				<h1>Posts</h1>
				<p class="page-lede">
					Notes, walkthroughs, and things worth writing down from work in computer vision, robotics,
					and applied machine learning.
				</p>
			</header>

			{
				posts.length > 0 ? (
					<div class="grid">
						{posts.map((post) => (
							<PostCard
								href={getNavHref(`/blog/${post.id}/`)}
								kind={post.data.kind}
								title={post.data.title}
								description={post.data.description}
								date={post.data.pubDate}
								heroImage={assertHeroMedia(post.data.heroImage)}
								heroVideo={assertHeroMedia(post.data.heroVideo)}
							/>
						))}
					</div>
				) : (
					<p class="empty">No posts published yet.</p>
				)
			}
		</main>
		<Footer />

		<style>
			.page-header {
				max-width: 620px;
				padding: 3rem 0 3.5rem;
			}

			.eyebrow {
				margin: 0 0 0.75rem;
				font-family: var(--font-mono);
				font-size: 0.75rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--color-ink-muted);
			}

			.page-header h1 {
				margin: 0 0 0.85rem;
				font-size: 2.5rem;
				letter-spacing: -0.025em;
			}

			.page-lede {
				margin: 0;
				font-size: 1.0625rem;
				font-weight: 300;
				line-height: 1.6;
				color: var(--color-ink-soft);
			}

			/* The floor rises with the page width, or auto-fill simply packs in a
			   fourth column and the cards come out narrower than before. At
			   1400px this holds three columns of about 440px — roughly a fifth
			   wider than the 360px they were. */
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
				gap: 1.25rem;
				align-items: start;
				padding-bottom: 3rem;
			}

			.empty {
				padding-bottom: 3rem;
				color: var(--color-ink-muted);
			}

			@media (max-width: 720px) {
				.page-header {
					padding: 2rem 0 2.5rem;
				}
				.page-header h1 {
					font-size: 1.875rem;
				}
			}
		</style>
	</body>
</html>
