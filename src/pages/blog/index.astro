---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import ContentCard from '../../components/ContentCard.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { getNavHref } from '../../lib/nav';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const [lead, ...rest] = posts;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Blog | Ali Maghami"
			description="Writing on computer vision, robotics, machine learning, and industrial automation."
		/>
	</head>
	<body>
		<Header />
		<main class="wrap">
			<header class="page-header">
				<p class="eyebrow">Writing</p>
				<h1>Blog</h1>
				<p class="page-lede">
					Notes, research write-ups, and practical lessons from building vision and automation
					systems.
				</p>
			</header>

			{
				lead && (
					<div class="lead-post">
						<ContentCard
							href={getNavHref(`/blog/${lead.id}/`)}
							title={lead.data.title}
							description={lead.data.description}
							date={lead.data.pubDate}
							image={lead.data.heroImage}
							featured
						/>
					</div>
				)
			}

			<div class="grid">
				{
					rest.map((post) => (
						<ContentCard
							href={getNavHref(`/blog/${post.id}/`)}
							title={post.data.title}
							description={post.data.description}
							date={post.data.pubDate}
							image={post.data.heroImage}
						/>
					))
				}
			</div>
		</main>
		<Footer />

		<style>
			.page-header {
				max-width: 620px;
				padding: 3rem 0 3rem;
			}

			.eyebrow {
				margin: 0 0 0.75rem;
				font-family: var(--font-mono);
				font-size: 0.75rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--color-ink-muted);
			}

			.page-header h1 {
				margin: 0 0 0.85rem;
				font-size: 2.5rem;
				letter-spacing: -0.025em;
			}

			.page-lede {
				margin: 0;
				font-size: 1.0625rem;
				font-weight: 300;
				line-height: 1.6;
				color: var(--color-ink-soft);
			}

			.lead-post {
				margin-bottom: 1.25rem;
			}

			/* A 16/9 banner is overpowering at full page width. */
			.lead-post :global(.card-media) {
				aspect-ratio: 3 / 1;
			}

			@media (max-width: 720px) {
				.lead-post :global(.card-media) {
					aspect-ratio: 16 / 9;
				}
			}

			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
				gap: 1.25rem;
			}

			@media (max-width: 720px) {
				.page-header {
					padding: 2rem 0 2rem;
				}
				.page-header h1 {
					font-size: 1.875rem;
				}
			}
		</style>
	</body>
</html>
