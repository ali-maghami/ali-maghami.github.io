---
import ProjectPost from '../../layouts/ProjectPost.astro';
import { renderPortfolioMarkdown } from '../../lib/markdown';
import { getProjectBySlug } from '../../lib/portfolio-data';

const slug = Astro.params.slug;
const project = slug ? await getProjectBySlug(slug) : undefined;
if (!project) return Astro.redirect('/404');
const bodyHtml = await renderPortfolioMarkdown(project.bodyMarkdown);
---

<ProjectPost {...project}>
	<Fragment set:html={bodyHtml} />
</ProjectPost>
