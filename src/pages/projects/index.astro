---
import { getCollection } from 'astro:content';
import Aurora from '../../components/Aurora.astro';
import BaseHead from '../../components/BaseHead.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { assertPortrait } from '../../lib/badges';
import { getNavHref } from '../../lib/nav';
import { categoryLabel } from '../../lib/projects';

const [home] = await getCollection('home');
const portrait = assertPortrait(home?.data.portrait);

const allProjects = (await getCollection('projects')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Active first, then archived. Listed rather than derived from the data so the
// order is fixed: archived work should not lead the page just because it
// happens to be the newer of the two groups on a given day.
const sections = ['active', 'archived'].map((category) => ({
	category,
	projects: allProjects.filter((p) => p.data.category === category),
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Projects | Ali Maghami"
			description="Personal projects and previous engineering work in computer vision, robotics, and applied AI."
		/>
	</head>
	<body>
		<Aurora />
		<Header />
		<main class="wrap">
			<header class="page-header">
				<p class="eyebrow">Portfolio</p>
				<h1>Projects</h1>
				<p class="page-lede">
					Personal side projects alongside professional engineering work in computer vision,
					robotics, and applied AI.
				</p>
			</header>

			{
				sections.map(
					({ category, projects }) =>
						projects.length > 0 && (
							<section class="collection">
								<div class="section-head">
									<h2>{categoryLabel(category)}</h2>
									<span class="count">{projects.length}</span>
								</div>
								<div class="grid">
									{projects.map((project) => (
										<ProjectCard
											href={getNavHref(`/projects/${project.id}/`)}
											stage={project.data.stage}
											title={project.data.title}
											description={project.data.description}
											date={project.data.pubDate}
											cardColor={project.data.cardColor}
											cardColorAlt={project.data.cardColorAlt}
											avatar={portrait}
										/>
									))}
								</div>
							</section>
						),
				)
			}

		</main>
		<Footer />

		<style>
			.page-header {
				max-width: 620px;
				padding: 3rem 0 3.5rem;
			}

			.eyebrow {
				margin: 0 0 0.75rem;
				font-family: var(--font-mono);
				font-size: 0.75rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--color-ink-muted);
			}

			.page-header h1 {
				margin: 0 0 0.85rem;
				font-size: 2.5rem;
				letter-spacing: -0.025em;
			}

			.page-lede {
				margin: 0;
				font-size: 1.0625rem;
				font-weight: 300;
				line-height: 1.6;
				color: var(--color-ink-soft);
			}

			.collection {
				margin-bottom: 3.5rem;
			}

			.collection .section-head {
				justify-content: flex-start;
				align-items: center;
				gap: 0.75rem;
				border-bottom: 1px solid var(--color-sand-200);
				margin-bottom: 1.5rem;
			}

			.count {
				font-family: var(--font-mono);
				font-size: 0.75rem;
				color: var(--color-ink-muted);
				background: var(--color-sand-100);
				border: 1px solid var(--color-sand-200);
				border-radius: 999px;
				padding: 0.1rem 0.5rem;
			}

			/* Two per row, stated rather than inferred: auto-fill picks a count
			   from whatever floor it is given, which is how widening the page
			   once produced narrower cards. One column below 760px, where two
			   would leave neither enough room. */
			.grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1.25rem;
				align-items: start;
			}

			@media (max-width: 760px) {
				.grid {
					grid-template-columns: 1fr;
				}
			}

			@media (max-width: 720px) {
				.page-header {
					padding: 2rem 0 2.5rem;
				}
				.page-header h1 {
					font-size: 1.875rem;
				}
			}
		</style>
	</body>
</html>
