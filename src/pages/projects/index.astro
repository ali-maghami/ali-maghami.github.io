---
import { paletteForPath } from '../../lib/palettes';
import Aurora from '../../components/Aurora.astro';
import BaseHead from '../../components/BaseHead.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { portraitImage } from '../../lib/badges';
import { getNavHref } from '../../lib/nav';
import { getHomePage, getSiteSettings, listProjects } from '../../lib/portfolio-data';
import { categoryLabel, stageDescription, stageLabel, stagesIn } from '../../lib/projects';

const [home, settings, allProjects] = await Promise.all([
	getHomePage(),
	getSiteSettings(),
	listProjects(),
]);
const portrait = portraitImage(home.portrait);

allProjects.sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

// Active first, then archived. Listed rather than derived from the data so the
// order is fixed: archived work should not lead the page just because it
// happens to be the newer of the two groups on a given day.
const sections = ['active', 'archived'].map((category) => ({
	category,
	projects: allProjects.filter((p) => p.category === category),
}));

// The stage badges on the cards are one word each. This says what the words
// mean, listing only the stages that actually appear.
const stages = stagesIn(allProjects);

// The section's colour, set on <html> so the stylesheet can key on it.
const paletteName = paletteForPath(Astro.url.pathname).name;
---

<!doctype html>
<html lang="en" data-palette={paletteName}>
	<head>
		<BaseHead
			title={`Projects | ${settings.siteTitle}`}
			description="Personal projects and previous engineering work in computer vision, robotics, and applied AI."
		/>
	</head>
	<body>
		<Aurora />
		<Header />
		<main id="main" class="wrap">
			<header class="page-header">
				<p class="eyebrow">Portfolio</p>
				<h1>Projects</h1>
				<p class="page-lede">
					Personal side projects alongside professional engineering work in computer vision,
					robotics, and applied AI.
				</p>
			</header>

			{
				sections.map(
					({ category, projects }) =>
						projects.length > 0 && (
							<section class="collection">
								<div class="section-head">
									<h2>{categoryLabel(category)}</h2>
									<span class="count">{projects.length}</span>
								</div>
								<div class="grid">
									{projects.map((project) => (
										<ProjectCard
											href={getNavHref(`/projects/${project.id}/`)}
											stage={project.stage}
											title={project.title}
											description={project.description}
											date={project.pubDate}
											cardColor={project.cardColor}
											cardColorAlt={project.cardColorAlt}
											avatar={portrait}
											contributors={project.contributors}
										/>
									))}
								</div>
							</section>
						),
				)
			}

			{
				stages.length > 0 && (
					<section class="legend" aria-labelledby="legend-heading">
						<h2 id="legend-heading">What the stages mean</h2>
						<dl>
							{stages.map((stage) => (
								<div class="legend-row">
									<dt>{stageLabel(stage)}</dt>
									<dd>{stageDescription(stage)}</dd>
								</div>
							))}
						</dl>
					</section>
				)
			}
		</main>
		<Footer />

		<style>
			.page-header {
				max-width: 620px;
				padding: 3rem 0 3.5rem;
			}

			.eyebrow {
				margin: 0 0 0.75rem;
				font-family: var(--font-mono);
				font-size: 0.75rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--color-ink-muted);
			}

			.page-header h1 {
				margin: 0 0 0.85rem;
				font-size: 2.5rem;
				letter-spacing: -0.025em;
			}

			.page-lede {
				margin: 0;
				font-size: 1.0625rem;
				font-weight: 300;
				line-height: 1.6;
				color: var(--color-ink-soft);
			}

			.collection {
				margin-bottom: 3.5rem;
			}

			.collection .section-head {
				justify-content: flex-start;
				align-items: center;
				gap: 0.75rem;
				border-bottom: 1px solid var(--color-sand-200);
				margin-bottom: 1.5rem;
			}

			.count {
				font-family: var(--font-mono);
				font-size: 0.75rem;
				color: var(--color-ink-muted);
				background: var(--color-sand-100);
				border: 1px solid var(--color-sand-200);
				border-radius: 999px;
				padding: 0.1rem 0.5rem;
			}

			/* Two per row, stated rather than inferred: auto-fill picks a count
			   from whatever floor it is given, which is how widening the page
			   once produced narrower cards. One column below 760px, where two
			   would leave neither enough room. */
			.grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1.25rem;
				align-items: start;
			}

			@media (max-width: 760px) {
				.grid {
					grid-template-columns: 1fr;
				}
			}

			.legend {
				max-width: 620px;
				margin-bottom: 2rem;
			}

			.legend h2 {
				margin: 0 0 0.75rem;
				font-family: var(--font-mono);
				font-size: 0.6875rem;
				font-weight: 500;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--color-ink-muted);
			}

			.legend dl {
				margin: 0;
				border-top: 1px solid var(--color-sand-200);
			}

			.legend-row {
				display: grid;
				grid-template-columns: minmax(0, 11rem) 1fr;
				gap: 1rem;
				padding: 0.6rem 0;
				border-bottom: 1px solid var(--color-sand-200);
				font-size: 0.875rem;
			}

			.legend dt {
				font-family: var(--font-mono);
				font-size: 0.75rem;
				color: var(--color-ink);
			}

			.legend dd {
				margin: 0;
				color: var(--color-ink-muted);
			}

			@media (max-width: 720px) {
				.legend-row {
					grid-template-columns: 1fr;
					gap: 0.15rem;
				}
			}

			@media (max-width: 720px) {
				.page-header {
					padding: 2rem 0 2.5rem;
				}
				.page-header h1 {
					font-size: 1.875rem;
				}
			}
		</style>
	</body>
</html>
