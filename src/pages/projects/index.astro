---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import ContentCard from '../../components/ContentCard.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { getNavHref } from '../../lib/nav';

const allProjects = (await getCollection('projects')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const personalProjects = allProjects.filter((p) => p.data.type === 'personal');
const previousProjects = allProjects.filter((p) => p.data.type === 'previous');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Projects | Ali Maghami"
			description="Personal projects and previous engineering work in computer vision, robotics, and machine learning."
		/>
	</head>
	<body>
		<Header />
		<main class="wrap">
			<header class="page-header">
				<p class="eyebrow">Portfolio</p>
				<h1>Projects</h1>
				<p class="page-lede">
					Personal side projects alongside professional engineering work in computer vision,
					robotics, and applied machine learning.
				</p>
			</header>

			{
				personalProjects.length > 0 && (
					<section class="collection">
						<div class="section-head">
							<h2>Personal Projects</h2>
							<span class="count">{personalProjects.length}</span>
						</div>
						<div class="grid">
							{personalProjects.map((project) => (
								<ContentCard
									href={getNavHref(`/projects/${project.id}/`)}
									title={project.data.title}
									description={project.data.description}
									date={project.data.pubDate}
									badge="Personal Project"
									badgeVariant="personal"
									tags={project.data.tags}
									image={project.data.heroImage}
								/>
							))}
						</div>
					</section>
				)
			}

			{
				previousProjects.length > 0 && (
					<section class="collection">
						<div class="section-head">
							<h2>Previous Work</h2>
							<span class="count">{previousProjects.length}</span>
						</div>
						<div class="grid">
							{previousProjects.map((project) => (
								<ContentCard
									href={getNavHref(`/projects/${project.id}/`)}
									title={project.data.title}
									description={project.data.description}
									date={project.data.pubDate}
									badge="Previous Work"
									badgeVariant="previous"
									tags={project.data.tags}
									image={project.data.heroImage}
								/>
							))}
						</div>
					</section>
				)
			}
		</main>
		<Footer />

		<style>
			.page-header {
				max-width: 620px;
				padding: 3rem 0 3.5rem;
			}

			.eyebrow {
				margin: 0 0 0.75rem;
				font-family: var(--font-mono);
				font-size: 0.75rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--color-ink-muted);
			}

			.page-header h1 {
				margin: 0 0 0.85rem;
				font-size: 2.5rem;
				letter-spacing: -0.025em;
			}

			.page-lede {
				margin: 0;
				font-size: 1.0625rem;
				font-weight: 300;
				line-height: 1.6;
				color: var(--color-ink-soft);
			}

			.collection {
				margin-bottom: 3.5rem;
			}

			.collection .section-head {
				justify-content: flex-start;
				align-items: center;
				gap: 0.75rem;
				border-bottom: 1px solid var(--color-sand-200);
				margin-bottom: 1.5rem;
			}

			.count {
				font-family: var(--font-mono);
				font-size: 0.75rem;
				color: var(--color-ink-muted);
				background: var(--color-sand-100);
				border: 1px solid var(--color-sand-200);
				border-radius: 999px;
				padding: 0.1rem 0.5rem;
			}

			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
				gap: 1.25rem;
				/* Not every entry has a banner; stretching rows to equal height
				   would open a gap inside the ones that don't. */
				align-items: start;
			}

			@media (max-width: 720px) {
				.page-header {
					padding: 2rem 0 2.5rem;
				}
				.page-header h1 {
					font-size: 1.875rem;
				}
			}
		</style>
	</body>
</html>
