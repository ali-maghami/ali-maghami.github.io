---
import Aurora from '../components/Aurora.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { renderPortfolioMarkdown } from '../lib/markdown';
import { getAboutPage } from '../lib/portfolio-data';

// A single-entry collection: the About page is content, edited at /admin/,
// rather than markup. The prose is the markdown body; the two definition
// lists below come from structured frontmatter so they stay consistently
// formatted no matter who edits them.
const about = await getAboutPage();
const { title, eyebrow, standfirst, skills, education } = about;
const bodyHtml = await renderPortfolioMarkdown(about.bodyMarkdown);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${title}`} description={standfirst.slice(0, 160)} />
	</head>

	<body>
		<Aurora />
		<Header />
		<main id="main">
			<div class="wrap-narrow article-head">
				<p class="eyebrow">{eyebrow}</p>
				<h1>{title}</h1>
				<p class="standfirst">{standfirst}</p>
			</div>

			<div class="wrap-narrow prose">
				<Fragment set:html={bodyHtml} />

				{
					skills.length > 0 && (
						<>
							<h2>Skills &amp; Interests</h2>
							<dl class="fact-list">
								{skills.map((skill) => (
									<div class="fact">
										<dt>{skill.area}</dt>
										<dd>{skill.detail}</dd>
									</div>
								))}
							</dl>
						</>
					)
				}

				{
					education.length > 0 && (
						<>
							<h2>Education</h2>
							<dl class="fact-list">
								{education.map((item) => (
									<div class="fact">
										<dt>{item.label}</dt>
										<dd>{item.detail}</dd>
									</div>
								))}
							</dl>
						</>
					)
				}
			</div>
		</main>
		<Footer />

		<style>
			.article-head {
				padding: 3rem 1.25rem 3rem;
			}

			.eyebrow {
				margin: 0 0 0.75rem;
				font-family: var(--font-mono);
				font-size: 0.75rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--color-ink-muted);
			}

			.article-head h1 {
				margin: 0;
				font-size: 2.5rem;
				line-height: 1.15;
				letter-spacing: -0.025em;
			}

			.standfirst {
				margin: 1rem 0 0;
				font-size: 1.125rem;
				font-weight: 300;
				line-height: 1.55;
				color: var(--color-ink-soft);
			}

			.prose {
				padding-bottom: 2rem;
			}

			/* Two-column term/detail rows, split by hairlines. */
			.fact-list {
				margin: 0 0 1.5rem;
				border-top: 1px solid var(--color-sand-200);
			}

			.fact {
				display: grid;
				grid-template-columns: minmax(0, 12rem) 1fr;
				gap: 1rem;
				padding: 0.75rem 0;
				border-bottom: 1px solid var(--color-sand-200);
			}

			.fact dt {
				font-size: 0.9375rem;
				font-weight: 600;
				color: var(--color-ink);
			}

			.fact dd {
				margin: 0;
				font-size: 0.9375rem;
				color: var(--color-ink-muted);
			}

			@media (max-width: 720px) {
				.article-head {
					padding: 2rem 1.25rem 1.5rem;
				}
				.article-head h1 {
					font-size: 1.875rem;
				}
				.fact {
					grid-template-columns: 1fr;
					gap: 0.15rem;
				}
			}
		</style>
	</body>
</html>
