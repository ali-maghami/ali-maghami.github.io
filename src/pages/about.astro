---
import Aurora from '../components/Aurora.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import StructuredData from '../components/StructuredData.astro';
import { portraitImage } from '../lib/badges';
import { publicFile } from '../lib/images';
import { renderPortfolioMarkdown } from '../lib/markdown';
import { getAboutPage, getHomePage, getSiteSettings } from '../lib/portfolio-data';
import { personSchema } from '../lib/structured-data';

// A single-entry collection: the About page is content, edited in the CMS,
// rather than markup. The prose is the markdown body; the two definition
// lists below come from structured fields so they stay consistently
// formatted no matter who edits them.
const [about, settings, home] = await Promise.all([getAboutPage(), getSiteSettings(), getHomePage()]);
const { title, eyebrow, standfirst, skills, education } = about;
const bodyHtml = await renderPortfolioMarkdown(about.bodyMarkdown);
const SOCIAL = settings.social;

// A CV is offered when one is committed at public/pdf/cv.pdf. A file rather
// than a CMS field for now: the CMS has nowhere to record it yet, and the
// document changes far less often than the content does.
const CV_PATH = '/pdf/cv.pdf';
const cv = publicFile(CV_PATH) ? CV_PATH : undefined;
const hasContact = Boolean(SOCIAL.email || SOCIAL.linkedin || SOCIAL.github || SOCIAL.scholar || cv);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${title}`} description={standfirst.slice(0, 160)} />
		<StructuredData data={personSchema(settings, Astro.site!, portraitImage(home.portrait))} />
	</head>

	<body>
		<Aurora />
		<Header />
		<main id="main">
			<div class="wrap-narrow article-head">
				<p class="eyebrow">{eyebrow}</p>
				<h1>{title}</h1>
				<p class="standfirst">{standfirst}</p>
			</div>

			<div class="wrap-narrow prose">
				<Fragment set:html={bodyHtml} />

				{
					skills.length > 0 && (
						<>
							<h2>Skills &amp; Interests</h2>
							<dl class="fact-list">
								{skills.map((skill) => (
									<div class="fact">
										<dt>{skill.area}</dt>
										<dd>{skill.detail}</dd>
									</div>
								))}
							</dl>
						</>
					)
				}

				{
					education.length > 0 && (
						<>
							<h2>Education</h2>
							<dl class="fact-list">
								{education.map((item) => (
									<div class="fact">
										<dt>{item.label}</dt>
										<dd>{item.detail}</dd>
									</div>
								))}
							</dl>
						</>
					)
				}

				{
					hasContact && (
						<section class="contact" aria-labelledby="contact-heading">
							<h2 id="contact-heading">Get in touch</h2>
							<p>
								Email is the quickest way to reach me, for collaboration, speaking, or a question
								about any of the work here.
							</p>
							<div class="contact-links">
								{SOCIAL.email && (
									<a class="btn btn-primary" href={`mailto:${SOCIAL.email}`}>
										Email me
									</a>
								)}
								{cv && (
									<a class="btn" href={cv} download>
										Download CV
									</a>
								)}
								{SOCIAL.linkedin && (
									<a class="btn" href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer">
										LinkedIn
									</a>
								)}
								{SOCIAL.github && (
									<a class="btn" href={SOCIAL.github} target="_blank" rel="noopener noreferrer">
										GitHub
									</a>
								)}
								{SOCIAL.scholar && (
									<a class="btn" href={SOCIAL.scholar} target="_blank" rel="noopener noreferrer">
										Google Scholar
									</a>
								)}
							</div>
						</section>
					)
				}
			</div>
		</main>
		<Footer />

		<style>
			.article-head {
				padding: 3rem 1.25rem 3rem;
			}

			.eyebrow {
				margin: 0 0 0.75rem;
				font-family: var(--font-mono);
				font-size: 0.75rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--color-ink-muted);
			}

			.article-head h1 {
				margin: 0;
				font-size: 2.5rem;
				line-height: 1.15;
				letter-spacing: -0.025em;
			}

			.standfirst {
				margin: 1rem 0 0;
				font-size: 1.125rem;
				font-weight: 300;
				line-height: 1.55;
				color: var(--color-ink-soft);
			}

			.prose {
				padding-bottom: 2rem;
			}

			/* Two-column term/detail rows, split by hairlines. */
			.fact-list {
				margin: 0 0 1.5rem;
				border-top: 1px solid var(--color-sand-200);
			}

			.fact {
				display: grid;
				grid-template-columns: minmax(0, 12rem) 1fr;
				gap: 1rem;
				padding: 0.75rem 0;
				border-bottom: 1px solid var(--color-sand-200);
			}

			.fact dt {
				font-size: 0.9375rem;
				font-weight: 600;
				color: var(--color-ink);
			}

			.fact dd {
				margin: 0;
				font-size: 0.9375rem;
				color: var(--color-ink-muted);
			}

			/* The one call to action on the page, after everything else has
			   been said. A panel rather than more prose, so it is found by a
			   reader skimming for how to get in touch. */
			.contact {
				margin: 2.5rem 0 1rem;
				padding: 1.5rem 1.6rem;
				background: var(--color-paper);
				border: 1px solid var(--color-sand-200);
				border-radius: 14px;
				box-shadow: var(--shadow-card);
			}

			.contact h2 {
				margin: 0 0 0.5rem;
				font-size: 1.25rem;
			}

			.contact p {
				margin: 0 0 1.1rem;
				font-size: 0.9375rem;
				color: var(--color-ink-soft);
			}

			.contact-links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
			}

			@media (max-width: 720px) {
				.article-head {
					padding: 2rem 1.25rem 1.5rem;
				}
				.article-head h1 {
					font-size: 1.875rem;
				}
				.fact {
					grid-template-columns: 1fr;
					gap: 0.15rem;
				}
			}
		</style>
	</body>
</html>
