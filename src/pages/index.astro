---
import { getCollection, render } from 'astro:content';
import Aurora from '../components/Aurora.astro';
import BaseHead from '../components/BaseHead.astro';
import ContentCard from '../components/ContentCard.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { assertPortrait } from '../lib/badges';
import { getNavHref } from '../lib/nav';
import { portraitStyle } from '../lib/portrait';

const projects = (await getCollection('projects'))
	.sort((a, b) => {
		if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
		return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
	})
	.slice(0, 6);

const [home] = await getCollection('home');

if (!home) {
	throw new Error(
		'The home collection is empty. Expected src/content/home/index.md — the hero renders from it.',
	);
}

const { heading, focusAreas } = home.data;
// Checked rather than trusted: a public path is only a string, so a stale one
// would render a broken image in the most prominent place on the site.
const portrait = assertPortrait(home.data.portrait);
// Size, border, opacity and filter are all set in the CMS. They arrive as
// custom properties rather than as classes so any value in range works without
// a stylesheet listing every one.
const portraitVars = portraitStyle({
	size: home.data.portraitSize,
	borderWidth: home.data.portraitBorderWidth,
	opacity: home.data.portraitOpacity,
	filter: home.data.portraitFilter,
	background: home.data.portraitBackground,
	backgroundOpacity: home.data.portraitBackgroundOpacity,
});
// The lede carries a link and emphasis, so it is markdown rather than a plain
// string and Astro renders it here.
const { Content: HeroLede } = await render(home);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Aurora />
		<div class="hero-shell">
			<div class="hero-content">
				<Header />
				<section class="hero">
					<div class:list={['hero-inner', { 'has-portrait': portrait }]}>
						{
							portrait && (
								<div class="portrait" style={portraitVars}>
									<img src={portrait} alt={`Portrait of ${SITE_TITLE}`} width="320" height="320" />
								</div>
							)
						}
						<div class="hero-text">
							<h1>{heading}</h1>
							<div class="lede">
								<HeroLede />
							</div>
							<ul class="focus-list">
								{focusAreas.map((area) => <li>{area}</li>)}
							</ul>
						</div>
					</div>
				</section>
			</div>
		</div>

		<main class="wrap">
			<section>
				<div class="section-head">
					<h2>Projects</h2>
					<a class="view-all" href={getNavHref('/projects/')}>View all &rarr;</a>
				</div>
				<div class="grid">
					{
						projects.map((proj) => (
							<ContentCard
								href={getNavHref(`/projects/${proj.id}/`)}
								title={proj.data.title}
								description={proj.data.description}
								date={proj.data.pubDate}
								badge={proj.data.type === 'personal' ? 'Personal Project' : 'Previous Work'}
								badgeVariant={proj.data.type}
								tags={proj.data.tags}
								image={proj.data.heroImage}
							/>
						))
					}
				</div>
			</section>
		</main>
		<Footer />

		<style>
			.hero-shell {
				position: relative;
				overflow: hidden;
			}

			.hero-content {
				position: relative;
				z-index: 10;
			}

			.hero {
				padding: 3.5rem 1.25rem 4.5rem;
			}

			.hero-inner {
				max-width: 660px;
				margin-inline: auto;
				text-align: left;
			}

			/* With a portrait the hero becomes two columns; the text keeps its
			   own measure so the line length stays readable rather than
			   stretching to fill whatever the image leaves over. */
			.hero-inner.has-portrait {
				display: flex;
				align-items: center;
				gap: 2.5rem;
				max-width: 900px;
			}

			.hero-text {
				min-width: 0;
			}

			/* The ring lives on the wrapper, not on the image. The image is
			   masked to a soft edge, and a mask fades a border along with
			   everything else it touches — so a thicker ring drawn on the image
			   would simply disappear at its outer edge. Kept apart, the ring
			   stays crisp while the photo still melts into the wash inside it. */
			.portrait {
				flex-shrink: 0;
				width: var(--portrait-size, 250px);
				height: var(--portrait-size, 250px);
				border: var(--portrait-border, 3px) solid var(--color-sand-300);
				/* Sits behind the photo and inside the ring, so it shows through
				   wherever the image is transparent or softened at the edge. */
				background: var(--portrait-bg, transparent);
				border-radius: 50%;
				display: grid;
				place-items: center;
			}

			.portrait img {
				width: 100%;
				height: 100%;
				border-radius: 50%;
				object-fit: cover;
				/* Desaturated on purpose: the wash behind it is a different
				   colour on every load, and full-strength skin tones clash with
				   most of them. Grey sits with all six. */
				filter: var(--portrait-filter, grayscale(1));
				opacity: var(--portrait-opacity, 0.8);
				/* Softens the cut-out edge so the circle belongs to the wash
				   instead of being stamped on top of it. Held just inside the
				   ring so the two do not fight. */
				mask-image: radial-gradient(circle, black 76%, transparent 100%);
				-webkit-mask-image: radial-gradient(circle, black 76%, transparent 100%);
			}

			.hero h1 {
				margin: 0 0 1.25rem;
				font-size: 2.5rem;
				line-height: 1.15;
				letter-spacing: -0.025em;
			}

			.lede {
				margin: 0;
				font-size: 1.125rem;
				font-weight: 300;
				line-height: 1.55;
				color: var(--color-ink-soft);
			}

			.lede strong {
				font-weight: 600;
				color: var(--color-ink);
			}

			.lede a {
				font-weight: 500;
				text-decoration: none;
			}

			.lede a:hover {
				text-decoration: underline;
			}

			.focus-list {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				list-style: none;
				margin: 1.75rem 0 0;
				padding: 0;
			}

			.focus-list li {
				font-family: var(--font-mono);
				font-size: 0.75rem;
				color: var(--color-ink-soft);
				background: rgb(255 255 255 / 55%);
				border: 1px solid rgb(255 255 255 / 50%);
				border-radius: 999px;
				padding: 0.35rem 0.75rem;
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
			}

			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
				gap: 1.25rem;
				align-items: start;
			}

			@media (max-width: 800px) {
				.hero {
					padding: 2.5rem 1.25rem 3rem;
				}
				/* Stacked rather than side by side: at this width a 250px circle
				   leaves the heading too narrow to set well. */
				.hero-inner.has-portrait {
					flex-direction: column;
					align-items: flex-start;
					gap: 1.5rem;
				}
				/* Capped rather than fixed, so the size chosen in the CMS is
				   respected until it would crowd the heading. */
				.portrait {
					width: min(var(--portrait-size, 250px), 150px);
					height: min(var(--portrait-size, 250px), 150px);
				}
				.hero h1 {
					font-size: 1.875rem;
				}
				.lede {
					font-size: 1rem;
				}
			}
		</style>
	</body>
</html>
