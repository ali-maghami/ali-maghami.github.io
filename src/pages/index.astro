---
import Aurora from '../components/Aurora.astro';
import BaseHead from '../components/BaseHead.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import StructuredData from '../components/StructuredData.astro';
import { heroMedia, portraitImage } from '../lib/badges';
import { highlights } from '../lib/highlights';
import { resizedImage } from '../lib/images';
import { renderPortfolioMarkdown } from '../lib/markdown';
import { getNavHref } from '../lib/nav';
import {
	getHomePage,
	getSiteSettings,
	listCertificates,
	listPapers,
	listPosts,
	listProjects,
} from '../lib/portfolio-data';
import { portraitStyle } from '../lib/portrait';
import { personSchema, websiteSchema } from '../lib/structured-data';
import { metaDescription, plainText } from '../lib/summary';

const [home, settings, allProjects, allPosts, papers, certificates] = await Promise.all([
	getHomePage(),
	getSiteSettings(),
	listProjects(),
	listPosts(),
	listPapers(),
	listCertificates(),
]);

// The figures under the lede, counted from what is published rather than
// typed in, so they cannot drift from the pages behind them.
const proof = highlights({ papers, projects: allProjects, certificates, since: home.since });
const { siteTitle: SITE_TITLE, siteDescription: SITE_DESCRIPTION } = settings;

// Newest first, with nothing jumping the queue. How many of each the page
// shows is set in the CMS alongside the rest of the home page.
// Active work only. The home page is a shopfront, not an archive — anything
// retired is still a click away on the projects page, which groups it under
// its own heading.
const projects = allProjects
	.filter((project) => project.category === 'active')
	.sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf())
	.slice(0, home.projectCount);

const posts = allPosts
	.sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf())
	.slice(0, home.postCount);

const { heading, focusAreas } = home;
// Checked rather than trusted: a public path is only a string, so a stale one
// would render a broken image in the most prominent place on the site.
const portrait = portraitImage(home.portrait);
// Size, border, opacity and filter are all set in the CMS. They arrive as
// custom properties rather than as classes so any value in range works without
// a stylesheet listing every one.
const portraitVars = portraitStyle({
	size: home.portraitSize,
	borderWidth: home.portraitBorderWidth,
	opacity: home.portraitOpacity,
	filter: home.portraitFilter,
	background: home.portraitBackground,
	backgroundOpacity: home.portraitBackgroundOpacity,
});
// The lede carries a link and emphasis, so it is markdown rather than a plain
// string and Astro renders it here.
const heroLede = await renderPortfolioMarkdown(home.bodyMarkdown);

// The description a search result or share shows is the page's own opening —
// the heading and the first sentence of the lede — rather than the terse site
// tagline, which stays as the fallback for a home page with no copy yet.
const description =
	metaDescription([heading, plainText(home.bodyMarkdown)]) || SITE_DESCRIPTION;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={heading ? `${SITE_TITLE} · ${heading}` : SITE_TITLE} description={description} />
		<StructuredData data={personSchema(settings, Astro.site!, portrait)} />
		<StructuredData data={websiteSchema(settings, Astro.site!)} />
	</head>
	<body>
		<Aurora />
		<div class="hero-shell">
			<div class="hero-content">
				<Header />
				<section class="hero">
					<div class:list={['hero-inner', { 'has-portrait': portrait }]}>
						{
							portrait && (
								<div class="portrait" style={portraitVars}>
									<img
										src={resizedImage(portrait, 640)}
										alt={`Portrait of ${SITE_TITLE}`}
										width="320"
										height="320"
										fetchpriority="high"
									/>
								</div>
							)
						}
						<div class="hero-text">
							<h1>{heading}</h1>
							{
								home.now && (
									<p class="now">
										<span class="now-label">Now</span>
										{home.now}
									</p>
								)
							}
							<div class="lede">
								<Fragment set:html={heroLede} />
							</div>
							<ul class="focus-list">
								{focusAreas.map((area) => <li>{area}</li>)}
							</ul>
							{
								proof.length > 0 && (
									<ul class="proof" aria-label="By the numbers">
										{proof.map((item) => (
											<li>
												<strong>{item.value}</strong> {item.label}
											</li>
										))}
									</ul>
								)
							}
						</div>
					</div>
				</section>
			</div>
		</div>

		<main id="main" class="wrap">
			<div class="rule" aria-hidden="true"></div>

			{/* One column until there is something to put in the other. */}
			<div class:list={['columns', { paired: posts.length > 0 }]}>
				{
					posts.length > 0 && (
						<section class="column">
							<div class="column-head">
								<h2>Posts</h2>
								<a class="view-all" href={getNavHref('/blog/')}>
									View all &rarr;
								</a>
							</div>
							<div class="stack">
								{posts.map((post) => (
									<PostCard
										href={getNavHref(`/blog/${post.id}/`)}
										kind={post.kind}
										title={post.title}
										description={post.description}
										date={post.pubDate}
										avatar={portrait}
										heroImage={heroMedia(post.heroImage)}
										heroVideo={heroMedia(post.heroVideo)}
										heroVideoPlayback={post.heroVideoPlayback}
									/>
								))}
							</div>
						</section>
					)
				}

				<section class="column">
					<div class="column-head">
						<h2>Projects</h2>
						<a class="view-all" href={getNavHref('/projects/')}>View all &rarr;</a>
					</div>
					<div class="stack">
						{
							projects.map((proj) => (
								<ProjectCard
									href={getNavHref(`/projects/${proj.id}/`)}
									stage={proj.stage}
									title={proj.title}
									description={proj.description}
									date={proj.pubDate}
									cardColor={proj.cardColor}
									cardColorAlt={proj.cardColorAlt}
									avatar={portrait}
									contributors={proj.contributors}
								/>
							))
						}
					</div>
				</section>
			</div>
		</main>
		<Footer />

		<style>
			.hero-shell {
				position: relative;
				overflow: hidden;
			}

			.hero-content {
				position: relative;
				z-index: 10;
			}

			.hero {
				padding: 3.5rem 1.25rem 4.5rem;
			}

			.hero-inner {
				max-width: 660px;
				margin-inline: auto;
				text-align: left;
			}

			/* With a portrait the hero becomes two columns; the text keeps its
			   own measure so the line length stays readable rather than
			   stretching to fill whatever the image leaves over. */
			.hero-inner.has-portrait {
				display: flex;
				align-items: center;
				gap: 2.5rem;
				max-width: 900px;
			}

			.hero-text {
				min-width: 0;
			}

			/* The ring lives on the wrapper, not on the image. The image is
			   masked to a soft edge, and a mask fades a border along with
			   everything else it touches — so a thicker ring drawn on the image
			   would simply disappear at its outer edge. Kept apart, the ring
			   stays crisp while the photo still melts into the wash inside it. */
			.portrait {
				flex-shrink: 0;
				width: var(--portrait-size, 250px);
				height: var(--portrait-size, 250px);
				border: var(--portrait-border, 3px) solid var(--color-sand-300);
				/* Sits behind the photo and inside the ring, so it shows through
				   wherever the image is transparent or softened at the edge. */
				background: var(--portrait-bg, transparent);
				border-radius: 50%;
				display: grid;
				place-items: center;
			}

			.portrait img {
				width: 100%;
				height: 100%;
				border-radius: 50%;
				object-fit: cover;
				/* Desaturated on purpose: the wash behind it is a different
				   colour on every load, and full-strength skin tones clash with
				   most of them. Grey sits with all six. */
				filter: var(--portrait-filter, grayscale(1));
				opacity: var(--portrait-opacity, 0.8);
				/* Softens the cut-out edge so the circle belongs to the wash
				   instead of being stamped on top of it. Held just inside the
				   ring so the two do not fight. */
				mask-image: radial-gradient(circle, black 76%, transparent 100%);
				-webkit-mask-image: radial-gradient(circle, black 76%, transparent 100%);
			}

			.hero h1 {
				margin: 0 0 1.25rem;
				font-size: 2.25rem;
				line-height: 1.15;
				letter-spacing: -0.025em;
			}

			.lede {
				margin: 0;
				font-size: 1.125rem;
				font-weight: 300;
				line-height: 1.55;
				color: var(--color-ink-soft);
			}

			.lede strong {
				font-weight: 600;
				color: var(--color-ink);
			}

			.lede a {
				font-weight: 500;
				text-decoration: none;
			}

			.lede a:hover {
				text-decoration: underline;
			}

			/* What the owner is doing at the moment: one line, set apart from the
			   lede by the small label so it reads as a fact rather than prose. */
			.now {
				display: flex;
				align-items: baseline;
				gap: 0.6rem;
				margin: -0.5rem 0 1.25rem;
				font-size: 0.9375rem;
				color: var(--color-ink-soft);
			}

			.now-label {
				flex-shrink: 0;
				font-family: var(--font-mono);
				font-size: 0.6875rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--color-ink-muted);
			}

			.focus-list {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				list-style: none;
				margin: 1.75rem 0 0;
				padding: 0;
			}

			/* The numbers behind the claim, in a quiet row under the focus areas.
			   Counted from the content, so they are as current as the pages. */
			.proof {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem 1.5rem;
				list-style: none;
				margin: 1.5rem 0 0;
				padding: 0;
				font-size: 0.875rem;
				color: var(--color-ink-muted);
			}

			.proof strong {
				font-weight: 600;
				color: var(--color-ink);
			}

			.focus-list li {
				font-family: var(--font-mono);
				font-size: 0.75rem;
				color: var(--color-ink-soft);
				background: rgb(255 255 255 / 55%);
				border: 1px solid rgb(255 255 255 / 50%);
				border-radius: 999px;
				padding: 0.35rem 0.75rem;
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
			}

			/* The hairline above the columns, with the small square end caps
			   from the reference. */
			.rule {
				position: relative;
				height: 1px;
				background: var(--color-sand-200);
				margin: 0 0 2.75rem;
			}

			.rule::before,
			.rule::after {
				content: '';
				position: absolute;
				top: -3px;
				width: 7px;
				height: 7px;
				border: 1px solid var(--color-sand-300);
				background: var(--color-paper);
			}

			.rule::before {
				left: 0;
			}

			.rule::after {
				right: 0;
			}

			.columns {
				display: grid;
				gap: 3rem;
			}

			/* Two columns only when both have something in them. The divider is
			   a border rather than an element so it spans exactly the taller
			   column without needing a height. */
			.columns.paired {
				grid-template-columns: 1fr 1fr;
				gap: 0;
			}

			.columns.paired .column + .column {
				border-left: 1px solid var(--color-sand-200);
				padding-left: 3rem;
			}

			.columns.paired .column:first-child {
				padding-right: 3rem;
			}

			.column-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 1.5rem;
			}

			.column-head h2 {
				margin: 0;
				font-size: 1.125rem;
				font-weight: 600;
				letter-spacing: -0.01em;
			}

			.view-all {
				font-size: 0.8125rem;
				white-space: nowrap;
			}

			.stack {
				display: grid;
				gap: 1.25rem;
				align-content: start;
			}

			@media (max-width: 900px) {
				/* Stacked: side by side, neither column has room for a card. */
				.columns.paired {
					grid-template-columns: 1fr;
					gap: 3rem;
				}
				.columns.paired .column + .column {
					border-left: none;
					padding-left: 0;
				}
				.columns.paired .column:first-child {
					padding-right: 0;
				}
			}

			@media (max-width: 800px) {
				.hero {
					padding: 2.5rem 1.25rem 3rem;
				}
				/* Stacked rather than side by side: at this width a 250px circle
				   leaves the heading too narrow to set well. */
				.hero-inner.has-portrait {
					flex-direction: column;
					align-items: flex-start;
					gap: 1.5rem;
				}
				/* Capped rather than fixed, so the size chosen in the CMS is
				   respected until it would crowd the heading. */
				.portrait {
					width: min(var(--portrait-size, 250px), 150px);
					height: min(var(--portrait-size, 250px), 150px);
				}
				.hero h1 {
					font-size: 1.875rem;
				}
				.lede {
					font-size: 1rem;
				}
			}
		</style>
	</body>
</html>
