---
import { getCollection } from 'astro:content';
import Aurora from '../components/Aurora.astro';
import BaseHead from '../components/BaseHead.astro';
import ContentCard from '../components/ContentCard.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getNavHref } from '../lib/nav';

const projects = (await getCollection('projects'))
	.sort((a, b) => {
		if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
		return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
	})
	.slice(0, 6);

const focusAreas = ['Computer Vision', 'Robotics', 'Machine Learning', 'Industrial AI'];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<div class="hero-shell">
			<Aurora />
			<div class="hero-content">
				<Header />
				<section class="hero">
					<div class="hero-inner">
						<h1>Turning AI into industrial reality.</h1>
						<p class="lede">
							I'm <strong>Ali Maghami</strong>, an engineer and researcher at <a
								href="https://www.hatch.com"
								target="_blank"
								rel="noopener noreferrer">Hatch Ltd.</a
							>, where I work on vision solutions for manufacturing and mining. Previously I built
							robotics perception systems at TetraGen Robotics and conducted research at the
							University of Manitoba and the National Research Council Canada.
						</p>
						<ul class="focus-list">
							{focusAreas.map((area) => <li>{area}</li>)}
						</ul>
					</div>
				</section>
			</div>
		</div>

		<main class="wrap">
			<section>
				<div class="section-head">
					<h2>Projects</h2>
					<a class="view-all" href={getNavHref('/projects/')}>View all &rarr;</a>
				</div>
				<div class="grid">
					{
						projects.map((proj) => (
							<ContentCard
								href={getNavHref(`/projects/${proj.id}/`)}
								title={proj.data.title}
								description={proj.data.description}
								date={proj.data.pubDate}
								badge={proj.data.type === 'personal' ? 'Personal Project' : 'Previous Work'}
								badgeVariant={proj.data.type}
								tags={proj.data.tags}
								image={proj.data.heroImage}
							/>
						))
					}
				</div>
			</section>
		</main>
		<Footer />

		<style>
			.hero-shell {
				position: relative;
				overflow: hidden;
			}

			.hero-content {
				position: relative;
				z-index: 10;
			}

			.hero {
				padding: 3.5rem 1.25rem 4.5rem;
				text-align: center;
			}

			.hero-inner {
				max-width: 660px;
				margin-inline: auto;
			}

			.hero h1 {
				margin: 0 0 1.25rem;
				font-size: 2.5rem;
				line-height: 1.15;
				letter-spacing: -0.025em;
			}

			.lede {
				margin: 0;
				font-size: 1.125rem;
				font-weight: 300;
				line-height: 1.55;
				color: var(--color-ink-soft);
			}

			.lede strong {
				font-weight: 600;
				color: var(--color-ink);
			}

			.lede a {
				font-weight: 500;
				text-decoration: none;
			}

			.lede a:hover {
				text-decoration: underline;
			}

			.focus-list {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.5rem;
				list-style: none;
				margin: 1.75rem 0 0;
				padding: 0;
			}

			.focus-list li {
				font-family: var(--font-mono);
				font-size: 0.75rem;
				color: var(--color-ink-soft);
				background: rgb(255 255 255 / 55%);
				border: 1px solid rgb(255 255 255 / 50%);
				border-radius: 999px;
				padding: 0.35rem 0.75rem;
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
			}

			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
				gap: 1.25rem;
				align-items: start;
			}

			@media (max-width: 800px) {
				.hero {
					padding: 2.5rem 1.25rem 3rem;
				}
				.hero h1 {
					font-size: 1.875rem;
				}
				.lede {
					font-size: 1rem;
				}
			}
		</style>
	</body>
</html>
