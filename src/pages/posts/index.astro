---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SOCIAL } from '../../consts';

const posts = (await getCollection('posts')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Posts | Ali Maghami" description="Selected LinkedIn posts." />
	</head>
	<body>
		<Header />
		<main class="wrap">
			<header class="page-header">
				<p class="eyebrow">LinkedIn</p>
				<h1>Posts</h1>
				<p class="page-lede">
					A selection of posts from LinkedIn. Each one is embedded from the original — comments and
					reactions live over there.
				</p>
				{
					SOCIAL.linkedin && (
						<p class="profile-link">
							<a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer">
								See everything on LinkedIn &rarr;
							</a>
						</p>
					)
				}
			</header>

			{
				posts.length > 0 ? (
					<div class="post-grid">
						{posts.map((post) => (
							<article class="post">
								<div class="post-head">
									<h2>{post.data.title}</h2>
									<FormattedDate date={post.data.pubDate} />
								</div>
								{post.data.summary && <p class="summary">{post.data.summary}</p>}
								{/*
									LinkedIn's official embed. Lazy-loaded because each frame pulls in
									LinkedIn's own scripts and tracking — without this they would all
									load on first paint and dominate the page's cost.
								*/}
								<iframe
									src={`https://www.linkedin.com/embed/feed/update/urn:li:share:${post.data.postId}`}
									height="560"
									width="100%"
									allowfullscreen
									loading="lazy"
									title={post.data.title}
								/>
							</article>
						))}
					</div>
				) : (
					<p class="empty">No posts featured yet.</p>
				)
			}
		</main>
		<Footer />

		<style>
			.page-header {
				max-width: 620px;
				padding: 3rem 0 3rem;
			}

			.eyebrow {
				margin: 0 0 0.75rem;
				font-family: var(--font-mono);
				font-size: 0.75rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--color-ink-muted);
			}

			.page-header h1 {
				margin: 0 0 0.85rem;
				font-size: 2.5rem;
				letter-spacing: -0.025em;
			}

			.page-lede {
				margin: 0;
				font-size: 1.0625rem;
				font-weight: 300;
				line-height: 1.6;
				color: var(--color-ink-soft);
			}

			.profile-link {
				margin: 1.25rem 0 0;
				font-size: 0.875rem;
			}

			.profile-link a {
				color: var(--color-ink-muted);
				text-decoration: none;
			}

			.profile-link a:hover {
				color: var(--color-ink);
			}

			.post-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(480px, 1fr));
				gap: 2rem;
				padding-bottom: 3rem;
			}

			.post-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-bottom: 0.4rem;
			}

			.post-head h2 {
				margin: 0;
				font-size: 1.0625rem;
				font-weight: 600;
				letter-spacing: -0.01em;
			}

			.post-head :global(time) {
				font-family: var(--font-mono);
				font-size: 0.75rem;
				color: var(--color-ink-muted);
			}

			.summary {
				margin: 0 0 0.85rem;
				font-size: 0.9375rem;
				line-height: 1.6;
				color: var(--color-ink-soft);
			}

			iframe {
				display: block;
				width: 100%;
				border: 1px solid var(--color-sand-200);
				border-radius: 10px;
				background: var(--color-sand-100);
			}

			.empty {
				padding-bottom: 3rem;
				color: var(--color-ink-muted);
			}

			@media (max-width: 720px) {
				.page-header {
					padding: 2rem 0 2rem;
				}
				.page-header h1 {
					font-size: 1.875rem;
				}
				.post-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</body>
</html>
