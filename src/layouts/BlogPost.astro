---
import { paletteForPath } from '../lib/palettes';
import Aurora from '../components/Aurora.astro';
import AuthorCard from '../components/AuthorCard.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ShareLinks from '../components/ShareLinks.astro';
import StructuredData from '../components/StructuredData.astro';
import { portraitImage, projectHero } from '../lib/badges';
import { leadImage } from '../lib/body-image';
import { publicImageSize, resizedImage, videoPoster } from '../lib/images';
import { getNavHref } from '../lib/nav';
import { type PostRecord, getHomePage, getSiteSettings, listPosts, listProjects } from '../lib/portfolio-data';
import { neighbours, relatedByTags } from '../lib/related';
import { blogPostingSchema } from '../lib/structured-data';

type Props = PostRecord;

const post = Astro.props;
const {
	id,
	title,
	description,
	pubDate,
	updatedDate,
	tags,
	heroImage,
	heroVideo,
	heroVideoPlayback,
	bodyMarkdown,
} = post;

// Muted rides along with autoplay because a browser will not start an unmuted
// video unprompted — without it, 'loop' and 'once' would quietly do nothing.
const autoplay = heroVideoPlayback !== 'viewer';
const loop = heroVideoPlayback === 'loop';

// The still beside a clip, if the author saved one: shown while the clip
// loads, and used as the share image when there is no hero image.
const poster = videoPoster(heroVideo);

// A post with neither a hero image nor a poster shares its first body image,
// provided that image is one the site can actually serve.
const shareImage = leadImage(heroImage ?? poster, bodyMarkdown);

const [settings, home, heroSize, allPosts, allProjects] = await Promise.all([
	getSiteSettings(),
	getHomePage(),
	publicImageSize(heroImage),
	listPosts(),
	listProjects(),
]);

const portrait = portraitImage(home.portrait);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

// The projects this post is about, found by the tags they share; the CMS
// records no link between them yet. Newest first, like the projects page.
const related = relatedByTags(
	post,
	[...allProjects].sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf()),
);

const { newer, older } = neighbours(
	[...allPosts].sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf()),
	id,
);

// The section's colour, set on <html> so the stylesheet can key on it.
const paletteName = paletteForPath(Astro.url.pathname).name;
---

<html lang="en" data-palette={paletteName}>
	<head>
		<BaseHead
			title={`${title} | ${settings.siteTitle}`}
			description={description}
			image={shareImage}
			imageAlt={title}
			type="article"
			publishedTime={pubDate}
			modifiedTime={updatedDate}
		/>
		<StructuredData data={blogPostingSchema(post, settings, Astro.site!, shareImage)} />
	</head>

	<body>
		<Aurora />
		<Header />
		<main id="main">
			<article>
				<div class="wrap-narrow article-head">
					<div class="meta-row">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span class="updated">
									Updated <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</div>

					<h1>{title}</h1>
					{description && <p class="standfirst">{description}</p>}

					{
						tags && tags.length > 0 && (
							<div class="tags">
								{tags.map((tag: string) => (
									<span class="tag">{tag}</span>
								))}
							</div>
						)
					}
				</div>

				{
					/*
					 * The largest thing above the fold, so it is fetched first
					 * rather than lazily, and it carries its size so the text
					 * below does not jump when it arrives.
					 */
					heroImage && (
						<div class="wrap-narrow hero">
							<img
								src={resizedImage(heroImage, 1280)}
								alt=""
								width={heroSize?.width}
								height={heroSize?.height}
								loading="eager"
								fetchpriority="high"
								decoding="async"
							/>
						</div>
					)
				}

				{
					/*
					 * Controls here but not on the card. On a card the clip is a
					 * preview inside a link, where a play button would compete
					 * with the click that opens the post; on the post itself the
					 * reader has arrived to watch it, so they get to pause,
					 * scrub and unmute. Whether it starts on its own is set per
					 * post in the CMS; when it does, it starts muted, which is
					 * the only way a browser will start it unprompted.
					 */
					heroVideo && (
						<div class="wrap-narrow hero">
							<video
								src={heroVideo}
								poster={poster}
								controls
								autoplay={autoplay}
								loop={loop}
								muted={autoplay}
								playsinline
								preload="metadata"
							/>
						</div>
					)
				}

				<div class="wrap-narrow prose">
					<slot />
				</div>

				<footer class="wrap-narrow post-footer">
					<div class="share-row">
						<span class="share-label">Share this post</span>
						<div class="share-links"><ShareLinks url={pageUrl} title={title} /></div>
					</div>

					<AuthorCard name={settings.siteTitle} line={home.heading} portrait={portrait} />

					{
						related.length > 0 && (
							<section class="related" aria-labelledby="related-heading">
								<h2 id="related-heading">{related.length === 1 ? 'The project behind this post' : 'Related projects'}</h2>
								<div class="related-grid">
									{related.map((project) => (
										<ProjectCard
											href={getNavHref(`/projects/${project.id}/`)}
											stage={project.stage}
											title={project.title}
											description={project.description}
											date={project.pubDate}
											cardColor={project.cardColor}
											cardColorAlt={project.cardColorAlt}
											avatar={portrait}
											contributors={project.contributors}
											image={leadImage(projectHero(project.heroImage), project.bodyMarkdown)}
										/>
									))}
								</div>
							</section>
						)
					}

					{
						(newer || older) && (
							<nav class="pager" aria-label="Other posts">
								{older ? (
									<a class="pager-link" href={getNavHref(`/blog/${older.id}/`)} rel="prev">
										<span class="pager-label">&larr; Older</span>
										<span class="pager-title">{older.title}</span>
									</a>
								) : (
									<span />
								)}
								{newer && (
									<a class="pager-link newer" href={getNavHref(`/blog/${newer.id}/`)} rel="next">
										<span class="pager-label">Newer &rarr;</span>
										<span class="pager-title">{newer.title}</span>
									</a>
								)}
							</nav>
						)
					}
				</footer>
			</article>
		</main>
		<Footer />

		<style>
			.article-head {
				padding: 3rem 1.25rem 2rem;
			}

			.meta-row {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-bottom: 1rem;
				font-family: var(--font-mono);
				font-size: 0.75rem;
				color: var(--color-ink-muted);
			}

			.updated {
				font-style: italic;
			}

			.article-head h1 {
				margin: 0;
				font-size: 2.5rem;
				line-height: 1.15;
				letter-spacing: -0.025em;
			}

			.standfirst {
				margin: 1rem 0 0;
				font-size: 1.125rem;
				font-weight: 300;
				line-height: 1.55;
				color: var(--color-ink-soft);
			}

			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-top: 1.25rem;
			}

			.hero {
				padding: 0 1.25rem 1rem;
			}

			.hero img,
			.hero video {
				display: block;
				width: 100%;
				height: auto;
				border-radius: 10px;
				border: 1px solid var(--color-sand-200);
			}

			.prose {
				padding-bottom: 1rem;
			}

			/* Everything after the piece: a hairline, then the share row, the
			   author, the work it describes, and the way to the next post. */
			.post-footer {
				display: grid;
				gap: 2rem;
				padding-top: 2rem;
				padding-bottom: 3rem;
				border-top: 1px solid var(--color-sand-200);
			}

			.share-row {
				display: flex;
				align-items: center;
				gap: 1rem;
			}

			.share-label {
				font-family: var(--font-mono);
				font-size: 0.6875rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--color-ink-muted);
			}

			.share-links {
				display: flex;
				align-items: center;
				gap: 0.85rem;
			}

			.related h2,
			.pager-label {
				font-family: var(--font-mono);
				font-size: 0.6875rem;
				font-weight: 500;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--color-ink-muted);
			}

			.related h2 {
				margin: 0 0 1rem;
			}

			.related-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 1.25rem;
			}

			.pager {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem;
			}

			.pager-link {
				display: grid;
				gap: 0.35rem;
				padding: 1rem 1.15rem;
				background: var(--color-paper);
				border: 1px solid var(--color-sand-200);
				border-radius: 12px;
				box-shadow: var(--shadow-card);
				color: var(--color-ink);
				text-decoration: none;
				transition:
					box-shadow 0.2s ease,
					border-color 0.2s ease;
			}

			.pager-link:hover {
				box-shadow: var(--shadow-card-hover);
				border-color: var(--color-sand-300);
			}

			.pager-link.newer {
				text-align: right;
			}

			.pager-title {
				font-size: 0.9375rem;
				font-weight: 600;
				line-height: 1.35;
			}

			.pager-link:hover .pager-title {
				text-decoration: underline;
				text-underline-offset: 2px;
			}

			@media (max-width: 720px) {
				.article-head {
					padding: 2rem 1.25rem 1.5rem;
				}
				.article-head h1 {
					font-size: 1.875rem;
				}
				.pager {
					grid-template-columns: 1fr;
				}
				.pager-link.newer {
					text-align: left;
				}
			}
		</style>
	</body>
</html>
