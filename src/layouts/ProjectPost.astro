---
import { Image } from 'astro:assets';
import { type CollectionEntry, getCollection } from 'astro:content';
import Aurora from '../components/Aurora.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { assertPortrait } from '../lib/badges';
import { stageLabel } from '../lib/projects';

type Props = CollectionEntry<'projects'>['data'];

const { title, description, pubDate, tags, repoUrl, liveUrl, stage, contributors, purpose, heroImage } =
	Astro.props;

// Share links need the page's own absolute URL, which only the built site
// knows — Astro.site plus this path, the same pair the canonical tag uses.
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const shareTargets = [
	{
		name: 'X',
		href: `https://twitter.com/intent/tweet?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(title)}`,
		path: 'M9.42 6.94 14.3 1.5h-1.16L8.9 6.22 5.53 1.5H1.63l5.11 7.14-5.11 5.7h1.16l4.47-4.99 3.57 4.99h3.9L9.42 6.94Zm-1.58 1.76-.52-.72-4.12-5.7h1.78l3.33 4.6.52.72 4.32 6h-1.78L7.84 8.7Z',
	},
	{
		name: 'LinkedIn',
		href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`,
		path: 'M4.94 13.4V6.17H2.54V13.4h2.4Zm-1.2-8.21c.84 0 1.36-.55 1.36-1.25-.02-.7-.52-1.25-1.34-1.25s-1.36.55-1.36 1.25c0 .7.52 1.25 1.33 1.25h.01Zm2.53 8.21h2.4V9.36c0-.22.01-.43.08-.59.17-.43.57-.88 1.23-.88.87 0 1.22.66 1.22 1.63V13.4h2.4V9.25c0-2.22-1.18-3.25-2.76-3.25-1.28 0-1.85.7-2.17 1.2v.02h-.01l.01-.02v-1.03h-2.4c.3.68 0 7.23 0 7.23Z',
	},
];

// The contributor photo lives on the home entry, as it does on the cards.
const [home] = await getCollection('home');
const portrait = assertPortrait(home?.data.portrait);

// The site owner leads, then anyone else credited on the entry — so their own
// name is not retyped on every project. Only the owner has a photograph; the
// rest get a placeholder, which keeps the rows aligned without inventing a
// likeness for someone who has not supplied one.
const makers = [
	{ name: SITE_TITLE, photo: portrait },
	...contributors.map((name) => ({ name, photo: undefined })),
];
---

<html lang="en">
	<head>
		<BaseHead title={`${title} | Projects`} description={description} />
	</head>

	<body>
		<Aurora />
		<Header />
		<main>
			<article>
				<div class="wrap-narrow article-head">
					<h1>{title}</h1>
					{description && <p class="standfirst">{description}</p>}

					{/* The facts about the work, each under the question it answers. */}
<div class="facts">
						<dl class="fact-col">
							{
								purpose && (
									<div class="fact">
										<dt>What's it for?</dt>
										<dd>{purpose}</dd>
									</div>
								)
							}

							{
								tags && tags.length > 0 && (
									<div class="fact">
										<dt>Tags</dt>
										<dd class="tags">
											{tags.map((tag: string) => (
												<span class="tag">{tag}</span>
											))}
										</dd>
									</div>
								)
							}

							<div class="fact">
								<dt>Share</dt>
								<dd class="share">
									{shareTargets.map((t) => (
										<a
											href={t.href}
											target="_blank"
											rel="noopener noreferrer"
											aria-label={`Share on ${t.name}`}
										>
											<svg viewBox="0 0 16 16" aria-hidden="true" width="17" height="17">
												<path fill="currentColor" d={t.path} />
											</svg>
										</a>
									))}
								</dd>
							</div>
						</dl>

						<dl class="fact-col">
							<div class="fact">
								<dt>Stage</dt>
								<dd>
									<span class="stage">{stageLabel(stage)}</span>
								</dd>
							</div>

							<div class="fact">
								<dt>Published</dt>
								<dd>
									<FormattedDate date={pubDate} precision="monthYear" />
								</dd>
							</div>
						</dl>

						<dl class="fact-col">
							<div class="fact">
								<dt>Who made it?</dt>
								<dd class="makers">
									{makers.map((maker) => (
										<span class="maker">
											{maker.photo ? (
												<img src={maker.photo} alt="" width="52" height="52" loading="lazy" />
											) : (
												<svg class="avatar" viewBox="0 0 32 32" aria-hidden="true">
													<circle cx="16" cy="16" r="16" fill="var(--color-sand-200)" />
													<circle cx="16" cy="12.5" r="5.2" fill="var(--color-sand-300)" />
													<path
														d="M5.6 30a10.8 10.8 0 0 1 20.8 0"
														fill="var(--color-sand-300)"
													/>
												</svg>
											)}
											<span>{maker.name}</span>
										</span>
									))}
								</dd>
							</div>
						</dl>
					</div>

					{
						(repoUrl || liveUrl) && (
							<div class="links">
								{repoUrl && (
									<a href={repoUrl} target="_blank" rel="noopener noreferrer" class="btn">
										GitHub Repository &rarr;
									</a>
								)}
								{liveUrl && (
									<a
										href={liveUrl}
										target="_blank"
										rel="noopener noreferrer"
										class="btn btn-primary"
									>
										Live Preview &rarr;
									</a>
								)}
							</div>
						)
					}
				</div>

				{
					heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt="" />
						</div>
					)
				}

				<div class="wrap-narrow prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />

		<style>
			.article-head {
				padding: 3rem 1.25rem 2rem;
			}

			.article-head h1 {
				margin: 0.85rem 0 0;
				font-size: 2.5rem;
				line-height: 1.15;
				letter-spacing: -0.025em;
			}

			.standfirst {
				margin: 1rem 0 0;
				font-size: 1.125rem;
				font-weight: 300;
				line-height: 1.55;
				color: var(--color-ink-soft);
			}

			/* Three columns while there is room, stacking on a phone. Each column
			   holds one or more facts, each under the label that says what it
			   is, as on the reference. */
			/* The first column is a third wider than an even split and the second
			   a third narrower — it holds prose and a tag list, while the second
			   holds two short values. Even thirds wrapped the first badly. */
			.facts {
				display: grid;
				grid-template-columns: 1.3fr 0.7fr 1fr;
				gap: 1.75rem 2.5rem;
				margin: 2.5rem 0 0;
			}

			@media (max-width: 720px) {
				.facts {
					grid-template-columns: 1fr;
				}
			}

			.fact-col {
				display: grid;
				gap: 1.5rem;
				align-content: start;
				margin: 0;
			}

			.fact dt {
				margin-bottom: 0.5rem;
				font-family: var(--font-mono);
				font-size: 0.6875rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--color-ink-muted);
			}

			.fact dd {
				margin: 0;
				font-size: 0.9375rem;
				color: var(--color-ink);
			}

			.fact :global(time) {
				font-size: 0.9375rem;
				color: var(--color-ink);
			}

			/* A pill, like the label on the project's card. */
			.stage {
				display: inline-block;
				font-family: var(--font-mono);
				font-size: 0.6875rem;
				letter-spacing: 0.04em;
				text-transform: uppercase;
				color: var(--color-ink-soft);
				background: var(--color-sand-100);
				border: 1px solid var(--color-sand-200);
				border-radius: 999px;
				padding: 0.25rem 0.65rem;
			}

			.share {
				display: flex;
				align-items: center;
				gap: 0.85rem;
			}

			.share a {
				display: inline-flex;
				color: var(--color-ink-soft);
				transition: color 0.2s ease;
			}

			.share a:hover {
				color: var(--color-ink);
			}

			/* One row each, rather than a run of names: a photograph beside a
			   list would look like it belonged to whichever name it touched. */
			.makers {
				display: grid;
				gap: 0.6rem;
			}

			.maker {
				display: flex;
				align-items: center;
				gap: 0.55rem;
			}

			.maker img,
			.maker .avatar {
				width: 28px;
				height: 28px;
				flex-shrink: 0;
				border-radius: 50%;
				object-fit: cover;
				border: 2px solid var(--color-paper);
				box-shadow: 0 0 0 1px var(--color-sand-300);
			}

			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin-top: 1.25rem;
			}

			.links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-top: 1.5rem;
			}

			.hero-image {
				max-width: 1020px;
				margin: 0 auto 3rem;
				padding-inline: 1.25rem;
			}

			.hero-image :global(img) {
				display: block;
				width: 100%;
				height: auto;
				border-radius: 16px;
				border: 1px solid var(--color-sand-200);
				box-shadow: 0 8px 30px rgb(48 48 38 / 8%);
			}

			.prose {
				padding-bottom: 2rem;
			}

			@media (max-width: 720px) {
				.article-head {
					padding: 2rem 1.25rem 1.5rem;
				}
				.article-head h1 {
					font-size: 1.875rem;
				}
				.hero-image {
					margin-bottom: 2rem;
				}
			}
		</style>
	</body>
</html>
