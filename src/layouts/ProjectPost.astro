---
import { Image } from 'astro:assets';
import { type CollectionEntry, getCollection } from 'astro:content';
import Aurora from '../components/Aurora.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { assertPortrait } from '../lib/badges';
import { stageLabel } from '../lib/projects';

type Props = CollectionEntry<'projects'>['data'];

const { title, description, pubDate, tags, repoUrl, liveUrl, stage, contributors, heroImage } =
	Astro.props;

// The site owner leads, then anyone else credited on the entry — so their own
// name is not retyped on every project.
const makers = [SITE_TITLE, ...contributors];

// The contributor photo lives on the home entry, as it does on the cards.
const [home] = await getCollection('home');
const portrait = assertPortrait(home?.data.portrait);
---

<html lang="en">
	<head>
		<BaseHead title={`${title} | Projects`} description={description} />
	</head>

	<body>
		<Aurora />
		<Header />
		<main>
			<article>
				<div class="wrap-narrow article-head">
					<h1>{title}</h1>
					{description && <p class="standfirst">{description}</p>}

					{/* The facts about the work, each under the question it answers. */}
					<dl class="facts">
						<div class="fact">
							<dt>Stage</dt>
							<dd>
								<span class="stage">{stageLabel(stage)}</span>
							</dd>
						</div>

						<div class="fact">
							<dt>Published</dt>
							<dd>
								<FormattedDate date={pubDate} precision="monthYear" />
							</dd>
						</div>

						<div class="fact">
							<dt>Who made it?</dt>
							<dd class="maker">
								{portrait && <img src={portrait} alt="" width="52" height="52" loading="lazy" />}
								<span>{makers.join(', ')}</span>
							</dd>
						</div>
					</dl>

					{
						tags && tags.length > 0 && (
							<div class="tags">
								{tags.map((tag: string) => (
									<span class="tag">{tag}</span>
								))}
							</div>
						)
					}

					{
						(repoUrl || liveUrl) && (
							<div class="links">
								{repoUrl && (
									<a href={repoUrl} target="_blank" rel="noopener noreferrer" class="btn">
										GitHub Repository &rarr;
									</a>
								)}
								{liveUrl && (
									<a
										href={liveUrl}
										target="_blank"
										rel="noopener noreferrer"
										class="btn btn-primary"
									>
										Live Preview &rarr;
									</a>
								)}
							</div>
						)
					}
				</div>

				{
					heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt="" />
						</div>
					)
				}

				<div class="wrap-narrow prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />

		<style>
			.article-head {
				padding: 3rem 1.25rem 2rem;
			}

			.article-head h1 {
				margin: 0.85rem 0 0;
				font-size: 2.5rem;
				line-height: 1.15;
				letter-spacing: -0.025em;
			}

			.standfirst {
				margin: 1rem 0 0;
				font-size: 1.125rem;
				font-weight: 300;
				line-height: 1.55;
				color: var(--color-ink-soft);
			}

			/* Columns while there is room, stacking on a phone. Each fact sits
			   under the label that says what it is, as on the reference. */
			.facts {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
				gap: 1.75rem 2.5rem;
				margin: 2.5rem 0 0;
			}

			.fact dt {
				margin-bottom: 0.5rem;
				font-family: var(--font-mono);
				font-size: 0.6875rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--color-ink-muted);
			}

			.fact dd {
				margin: 0;
				font-size: 0.9375rem;
				color: var(--color-ink);
			}

			.fact :global(time) {
				font-size: 0.9375rem;
				color: var(--color-ink);
			}

			/* A pill, like the label on the project's card. */
			.stage {
				display: inline-block;
				font-family: var(--font-mono);
				font-size: 0.6875rem;
				letter-spacing: 0.04em;
				text-transform: uppercase;
				color: var(--color-ink-soft);
				background: var(--color-sand-100);
				border: 1px solid var(--color-sand-200);
				border-radius: 999px;
				padding: 0.25rem 0.65rem;
			}

			.maker {
				display: flex;
				align-items: center;
				gap: 0.55rem;
			}

			.maker img {
				width: 28px;
				height: 28px;
				border-radius: 50%;
				object-fit: cover;
				border: 2px solid var(--color-paper);
				box-shadow: 0 0 0 1px var(--color-sand-300);
			}

			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin-top: 1.25rem;
			}

			.links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-top: 1.5rem;
			}

			.hero-image {
				max-width: 1020px;
				margin: 0 auto 3rem;
				padding-inline: 1.25rem;
			}

			.hero-image :global(img) {
				display: block;
				width: 100%;
				height: auto;
				border-radius: 16px;
				border: 1px solid var(--color-sand-200);
				box-shadow: 0 8px 30px rgb(48 48 38 / 8%);
			}

			.prose {
				padding-bottom: 2rem;
			}

			@media (max-width: 720px) {
				.article-head {
					padding: 2rem 1.25rem 1.5rem;
				}
				.article-head h1 {
					font-size: 1.875rem;
				}
				.hero-image {
					margin-bottom: 2rem;
				}
			}
		</style>
	</body>
</html>
