---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'projects'>['data'];

const { title, description, pubDate, tags, repoUrl, liveUrl, type, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={`${title} | Projects`} description={description} />
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="wrap-narrow article-head">
					<div class="meta-row">
						<FormattedDate date={pubDate} />
						<span class:list={['badge', `badge-${type}`]}>
							{type === 'personal' ? 'Personal Project' : 'Previous Work'}
						</span>
					</div>

					<h1>{title}</h1>
					{description && <p class="standfirst">{description}</p>}

					{
						tags && tags.length > 0 && (
							<div class="tags">
								{tags.map((tag: string) => (
									<span class="tag">{tag}</span>
								))}
							</div>
						)
					}

					{
						(repoUrl || liveUrl) && (
							<div class="links">
								{repoUrl && (
									<a href={repoUrl} target="_blank" rel="noopener noreferrer" class="btn">
										GitHub Repository &rarr;
									</a>
								)}
								{liveUrl && (
									<a
										href={liveUrl}
										target="_blank"
										rel="noopener noreferrer"
										class="btn btn-primary"
									>
										Live Preview &rarr;
									</a>
								)}
							</div>
						)
					}
				</div>

				{
					heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt="" />
						</div>
					)
				}

				<div class="wrap-narrow prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />

		<style>
			.article-head {
				padding: 3rem 1.25rem 2rem;
			}

			.article-head h1 {
				margin: 0.85rem 0 0;
				font-size: 2.5rem;
				line-height: 1.15;
				letter-spacing: -0.025em;
			}

			.standfirst {
				margin: 1rem 0 0;
				font-size: 1.125rem;
				font-weight: 300;
				line-height: 1.55;
				color: var(--color-ink-soft);
			}

			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin-top: 1.25rem;
			}

			.links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-top: 1.5rem;
			}

			.hero-image {
				max-width: 1020px;
				margin: 0 auto 3rem;
				padding-inline: 1.25rem;
			}

			.hero-image :global(img) {
				display: block;
				width: 100%;
				height: auto;
				border-radius: 16px;
				border: 1px solid var(--color-sand-200);
				box-shadow: 0 8px 30px rgb(48 48 38 / 8%);
			}

			.prose {
				padding-bottom: 2rem;
			}

			@media (max-width: 720px) {
				.article-head {
					padding: 2rem 1.25rem 1.5rem;
				}
				.article-head h1 {
					font-size: 1.875rem;
				}
				.hero-image {
					margin-bottom: 2rem;
				}
			}
		</style>
	</body>
</html>
