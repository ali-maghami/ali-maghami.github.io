---
import Aurora from '../components/Aurora.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import GenericAvatar from '../components/GenericAvatar.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import ShareLinks from '../components/ShareLinks.astro';
import { heroMedia, portraitImage, projectHero } from '../lib/badges';
import { firstBodyImage } from '../lib/body-image';
import { publicFile, resizedImage } from '../lib/images';
import { getNavHref } from '../lib/nav';
import { type ProjectRecord, getHomePage, getSiteSettings, listPosts } from '../lib/portfolio-data';
import { relatedByTags } from '../lib/related';
import { stageDescription, stageLabel } from '../lib/projects';

type Props = ProjectRecord;

const project = Astro.props;
const {
	title,
	description,
	pubDate,
	tags,
	repoUrl,
	liveUrl,
	stage,
	contributors,
	purpose,
	heroImage: rawHeroImage,
	bodyMarkdown,
} = project;

// Checked rather than trusted: a stale path renders a blank where the lead
// image should be, and the CMS is what writes it.
const heroImage = projectHero(rawHeroImage);

// Several projects carry their lead image in the body rather than the hero
// field. A share of the page shows that rather than the generic site card, as
// long as it is a file the site can serve.
const bodyImage = firstBodyImage(bodyMarkdown);
const shareImage =
	heroImage ??
	(bodyImage && (bodyImage.startsWith('/uploads/') || publicFile(bodyImage)) ? bodyImage : undefined);

// Share links need the page's own absolute URL, which only the built site
// knows — Astro.site plus this path, the same pair the canonical tag uses.
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
// The contributor photo lives on the home entry, as it does on the cards.
const [home, settings, allPosts] = await Promise.all([getHomePage(), getSiteSettings(), listPosts()]);
const SITE_TITLE = settings.siteTitle;
const portrait = portraitImage(home.portrait);

// The posts written about this work, found by the tags they share; the CMS
// records no link between them yet. Newest first.
const related = relatedByTags(
	project,
	[...allPosts].sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf()),
);

// The site owner leads, then anyone else credited on the entry — so their own
// name is not retyped on every project. Only the owner has a photograph; the
// rest get a placeholder, which keeps the rows aligned without inventing a
// likeness for someone who has not supplied one.
const makers = [
	{ name: SITE_TITLE, photo: resizedImage(portrait, 104) },
	...contributors.map((name) => ({ name, photo: undefined })),
];
---

<html lang="en">
	<head>
		<BaseHead
			title={`${title} | ${SITE_TITLE}`}
			description={description}
			image={shareImage}
			imageAlt={title}
			type="article"
			publishedTime={pubDate}
		/>
	</head>

	<body>
		<Aurora />
		<Header />
		<main id="main">
			<article>
				<div class="wrap-narrow article-head">
					<h1>{title}</h1>
					{description && <p class="standfirst">{description}</p>}

					{/* The facts about the work, each under the question it answers. */}
<div class="facts">
						<dl class="fact-col">
							{
								purpose && (
									<div class="fact">
										<dt>What's it for?</dt>
										<dd>{purpose}</dd>
									</div>
								)
							}

						</dl>

						<dl class="fact-col">
							<div class="fact">
								<dt>Stage</dt>
								<dd>
									<span class="stage" title={stageDescription(stage)}>{stageLabel(stage)}</span>
								</dd>
							</div>

							<div class="fact">
								<dt>Published</dt>
								<dd>
									<FormattedDate date={pubDate} precision="monthYear" />
								</dd>
							</div>
						</dl>

						<dl class="fact-col">
							<div class="fact">
								<dt>Who made it?</dt>
								<dd class="makers">
									{makers.map((maker) => (
										<span class="maker">
											{maker.photo ? (
												<img src={maker.photo} alt="" width="52" height="52" loading="lazy" />
											) : (
												<GenericAvatar />
											)}
											<span>{maker.name}</span>
										</span>
									))}
								</dd>
							</div>
						</dl>

						{
							tags && tags.length > 0 && (
								<dl class="fact-wide">
									<div class="fact">
										<dt>Tags</dt>
										<dd class="tags">
											{tags.map((tag: string) => (
												<span class="tag">{tag}</span>
											))}
										</dd>
									</div>
								</dl>
							)
						}

						<dl class="fact-wide">
							<div class="fact">
								<dt>Share</dt>
								<dd class="share">
									<ShareLinks url={pageUrl} title={title} />
								</dd>
							</div>
						</dl>
					</div>

					{
						(repoUrl || liveUrl) && (
							<div class="links">
								{repoUrl && (
									<a href={repoUrl} target="_blank" rel="noopener noreferrer" class="btn">
										GitHub Repository &rarr;
									</a>
								)}
								{liveUrl && (
									<a
										href={liveUrl}
										target="_blank"
										rel="noopener noreferrer"
										class="btn btn-primary"
									>
										Live Preview &rarr;
									</a>
								)}
							</div>
						)
					}
				</div>

				{
					heroImage && (
						<div class="hero-image">
							<img
								src={resizedImage(heroImage, 1280)}
								alt=""
								width="1020"
								height="510"
								loading="eager"
								fetchpriority="high"
							/>
						</div>
					)
				}

				<div class="wrap-narrow prose">
					<slot />
				</div>

				{
					related.length > 0 && (
						<section class="wrap-narrow related" aria-labelledby="related-heading">
							<h2 id="related-heading">{related.length === 1 ? 'Read the write-up' : 'Posts about this work'}</h2>
							<div class="related-grid">
								{related.map((post) => (
									<PostCard
										href={getNavHref(`/blog/${post.id}/`)}
										kind={post.kind}
										title={post.title}
										description={post.description}
										date={post.pubDate}
										avatar={portrait}
										heroImage={heroMedia(post.heroImage)}
										heroVideo={heroMedia(post.heroVideo)}
										heroVideoPlayback={post.heroVideoPlayback}
									/>
								))}
							</div>
						</section>
					)
				}
			</article>
		</main>
		<Footer />

		<style>
			.article-head {
				padding: 3rem 1.25rem 2rem;
			}

			.article-head h1 {
				margin: 0.85rem 0 0;
				font-size: 2.5rem;
				line-height: 1.15;
				letter-spacing: -0.025em;
			}

			.standfirst {
				margin: 1rem 0 0;
				font-size: 1.125rem;
				font-weight: 300;
				line-height: 1.55;
				color: var(--color-ink-soft);
			}

			/* Three columns while there is room, stacking on a phone. Each column
			   holds one or more facts, each under the label that says what it
			   is, as on the reference. */
			/* The first column is a third wider than an even split and the second
			   a third narrower — it holds prose and a tag list, while the second
			   holds two short values. Even thirds wrapped the first badly. */
			.facts {
				display: grid;
				grid-template-columns: 1.3fr 0.7fr 1fr;
				gap: 1.75rem 2.5rem;
				margin: 2.5rem 0 0;
			}

			@media (max-width: 720px) {
				.facts {
					grid-template-columns: 1fr;
				}
			}

			.fact-col {
				display: grid;
				gap: 1.5rem;
				align-content: start;
				margin: 0;
			}

			/* Spans every column. Tags wrap badly in a single column, and share
			   links sit under them rather than beside the first fact. */
			.fact-wide {
				grid-column: 1 / -1;
				margin: 0;
			}

			.fact dt {
				margin-bottom: 0.5rem;
				font-family: var(--font-mono);
				font-size: 0.6875rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--color-ink-muted);
			}

			.fact dd {
				margin: 0;
				font-size: 0.9375rem;
				color: var(--color-ink);
			}

			.fact :global(time) {
				font-size: 0.9375rem;
				color: var(--color-ink);
			}

			/* A pill, like the label on the project's card. */
			.stage {
				display: inline-block;
				font-family: var(--font-mono);
				font-size: 0.6875rem;
				letter-spacing: 0.04em;
				text-transform: uppercase;
				color: var(--color-ink-soft);
				background: var(--color-sand-100);
				border: 1px solid var(--color-sand-200);
				border-radius: 999px;
				padding: 0.25rem 0.65rem;
			}

			.share {
				display: flex;
				align-items: center;
				gap: 0.85rem;
			}

			.related {
				padding-top: 1rem;
				padding-bottom: 2rem;
			}

			.related h2 {
				margin: 0 0 1rem;
				font-family: var(--font-mono);
				font-size: 0.6875rem;
				font-weight: 500;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--color-ink-muted);
			}

			.related-grid {
				display: grid;
				gap: 1.25rem;
			}

			/* One row each, rather than a run of names: a photograph beside a
			   list would look like it belonged to whichever name it touched. */
			.makers {
				display: grid;
				gap: 0.6rem;
			}

			.maker {
				display: flex;
				align-items: center;
				gap: 0.55rem;
			}

			/* :global on the stand-in because it is a child component and
			   carries its own scope id — a scoped selector matches the owner's
			   <img> and silently leaves the SVG unsized, which renders it at
			   its intrinsic size rather than at 28px. */
			.maker img,
			.maker :global(.avatar) {
				width: 28px;
				height: 28px;
				flex-shrink: 0;
				border-radius: 50%;
				object-fit: cover;
				border: 2px solid var(--color-paper);
				box-shadow: 0 0 0 1px var(--color-sand-300);
			}

			/* The portrait is a line drawing on transparency, so without a
			   backing the page wash shows through the paper it was drawn on.
			   Only the photograph needs it: the stand-in draws its own disc. */
			.maker img {
				background: var(--color-paper);
			}

			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin-top: 1.25rem;
			}

			.links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-top: 1.5rem;
			}

			.hero-image {
				max-width: 1020px;
				margin: 0 auto 3rem;
				padding-inline: 1.25rem;
			}

			.hero-image :global(img) {
				display: block;
				width: 100%;
				height: auto;
				border-radius: 16px;
				border: 1px solid var(--color-sand-200);
				box-shadow: 0 8px 30px rgb(48 48 38 / 8%);
			}

			.prose {
				padding-bottom: 2rem;
			}

			@media (max-width: 720px) {
				.article-head {
					padding: 2rem 1.25rem 1.5rem;
				}
				.article-head h1 {
					font-size: 1.875rem;
				}
				.hero-image {
					margin-bottom: 2rem;
				}
			}
		</style>
	</body>
</html>
