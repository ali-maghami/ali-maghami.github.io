---
/*
 * Share buttons for a page, the same pair wherever they appear. The page's
 * absolute URL comes from the caller — Astro.site plus the path, the pair the
 * canonical tag uses — because only the built site knows it.
 */
interface Props {
	url: string;
	title: string;
}

const { url, title } = Astro.props;

const targets = [
	{
		name: 'X',
		href: `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`,
		path: 'M9.42 6.94 14.3 1.5h-1.16L8.9 6.22 5.53 1.5H1.63l5.11 7.14-5.11 5.7h1.16l4.47-4.99 3.57 4.99h3.9L9.42 6.94Zm-1.58 1.76-.52-.72-4.12-5.7h1.78l3.33 4.6.52.72 4.32 6h-1.78L7.84 8.7Z',
	},
	{
		name: 'LinkedIn',
		href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`,
		path: 'M4.94 13.4V6.17H2.54V13.4h2.4Zm-1.2-8.21c.84 0 1.36-.55 1.36-1.25-.02-.7-.52-1.25-1.34-1.25s-1.36.55-1.36 1.25c0 .7.52 1.25 1.33 1.25h.01Zm2.53 8.21h2.4V9.36c0-.22.01-.43.08-.59.17-.43.57-.88 1.23-.88.87 0 1.22.66 1.22 1.63V13.4h2.4V9.25c0-2.22-1.18-3.25-2.76-3.25-1.28 0-1.85.7-2.17 1.2v.02h-.01l.01-.02v-1.03h-2.4c.3.68 0 7.23 0 7.23Z',
	},
];
---

{
	targets.map((target) => (
		<a href={target.href} target="_blank" rel="noopener noreferrer" aria-label={`Share on ${target.name}`}>
			<svg viewBox="0 0 16 16" aria-hidden="true" width="17" height="17">
				<path fill="currentColor" d={target.path} />
			</svg>
		</a>
	))
}

<style>
	a {
		display: inline-flex;
		color: var(--color-ink-soft);
		transition: color 0.2s ease;
	}

	a:hover {
		color: var(--color-ink);
	}
</style>
