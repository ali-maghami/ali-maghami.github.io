---
import type { HTMLAttributes } from 'astro/types';
import { isNavActive } from '../lib/nav';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

/*
 * Sections are compared, not paths. The previous check stripped BASE_URL from
 * the pathname, which with a base of "/" removed the leading slash — so
 * "/projects/" became "projects/" and could never equal its own href. Home was
 * the only link that ever matched, because it was the one case where the
 * fallback happened to produce "/".
 */
const isActive = isNavActive(Astro.url.pathname, String(href ?? ''));
---

<a
	href={href}
	class:list={['nav-link', className, { active: isActive }]}
	aria-current={isActive ? 'page' : undefined}
	{...props}
>
	<slot />
</a>

<style>
	.nav-link {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		border-radius: 999px;
		padding: 0.4rem 0.85rem;
		font-size: 0.875rem;
		font-weight: 500;
		white-space: nowrap;
		text-decoration: none;
		color: var(--color-ink-muted);
		transition: color 0.2s ease;
	}

	.nav-link:hover {
		color: var(--color-ink);
	}

	.nav-link.active {
		color: var(--color-ink);
	}
</style>
