---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import FormattedDate from './FormattedDate.astro';

interface Props {
	href: string;
	title: string;
	description?: string;
	date?: Date;
	badge?: string;
	badgeVariant?: 'personal' | 'previous';
	tags?: string[];
	image?: ImageMetadata;
	featured?: boolean;
}

const {
	href,
	title,
	description,
	date,
	badge,
	badgeVariant = 'personal',
	tags = [],
	image,
	featured = false,
} = Astro.props;
---

<article class:list={['card', { featured }]}>
	<a class="card-link" href={href}>
		{
			image && (
				<div class="card-media">
					<Image src={image} alt="" width={880} height={495} loading="lazy" />
				</div>
			)
		}
		<div class="card-body">
			{
				(date || badge) && (
					<div class="meta-row">
						{date && <FormattedDate date={date} />}
						{badge && <span class:list={['badge', `badge-${badgeVariant}`]}>{badge}</span>}
					</div>
				)
			}
			<h3 class="card-title">{title}</h3>
			{description && <p class="card-desc">{description}</p>}
			{
				tags.length > 0 && (
					<div class="card-tags">
						{tags.slice(0, 4).map((tag) => (
							<span class="tag">{tag}</span>
						))}
					</div>
				)
			}
		</div>
	</a>
</article>

<style>
	.card-link {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
		color: inherit;
	}

	.card-media {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--color-sand-100);
		border-bottom: 1px solid var(--color-sand-200);
	}

	.card-media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.35s ease-out;
	}

	.card:hover .card-media :global(img) {
		transform: scale(1.03);
	}

	.card-body {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 1.15rem 1.25rem 1.35rem;
		flex: 1;
	}

	.card-title {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 600;
		line-height: 1.25;
		color: var(--color-ink);
	}

	.card-desc {
		margin: 0;
		font-size: 0.875rem;
		line-height: 1.55;
		color: var(--color-ink-soft);
		display: -webkit-box;
		-webkit-line-clamp: 4;
		line-clamp: 4;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-top: auto;
		padding-top: 0.35rem;
	}

	/* Larger treatment for the lead card in a list. */
	.card.featured .card-title {
		font-size: 1.625rem;
	}

	.card.featured .card-desc {
		font-size: 0.9375rem;
		-webkit-line-clamp: 3;
		line-clamp: 3;
	}
</style>
