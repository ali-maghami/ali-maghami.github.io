---
import FormattedDate from './FormattedDate.astro';

interface Props {
	href: string;
	kind: string;
	title: string;
	description?: string;
	date: Date;
	avatar?: string;
	heroImage?: string;
	heroVideo?: string;
	heroVideoPlayback?: 'loop' | 'once' | 'viewer';
}

const {
	href,
	kind,
	title,
	description,
	date,
	avatar,
	heroImage,
	heroVideo,
	heroVideoPlayback = 'loop',
} = Astro.props;

// 'viewer' cannot mean what it does on the post page: the card is a link, so a
// play button inside it would compete with the click that opens the post. It
// shows the first frame instead, which is the preview the card wants anyway.
const autoplay = heroVideoPlayback !== 'viewer';
const loop = heroVideoPlayback === 'loop';
---

<article class="post-card">
	{
		/*
		 * An image leads the card, above everything else. A video does not: it
		 * follows the title, because a clip needs its heading to make sense of
		 * what is moving, while a still reads on its own.
		 */
	}
	<a class="post-link" href={href}>
		{
			heroImage && (
				<img class="post-hero" src={heroImage} alt="" loading="lazy" decoding="async" />
			)
		}

		<div class="post-body">
		<div class="post-meta">
			<svg class="post-icon" viewBox="0 0 16 16" aria-hidden="true" width="13" height="13">
				<rect x="1.5" y="2.5" width="13" height="11" rx="2" fill="none" stroke="currentColor" />
				<path d="M4.5 6.5h7M4.5 9.5h4" stroke="currentColor" stroke-linecap="round" />
			</svg>
			<span class="post-kind">{kind}</span>
			<FormattedDate date={date} />
			{avatar && <img class="post-avatar" src={avatar} alt="" width="44" height="44" loading="lazy" />}
		</div>

		<h3 class="post-title">{title}</h3>

		{
			heroVideo && (
				<video
					class="post-video"
					src={heroVideo}
					autoplay={autoplay}
					loop={loop}
					muted={autoplay}
					playsinline
					preload="metadata"
				/>
			)
		}

		{description && <p class="post-hook">{description}</p>}
		</div>
	</a>
</article>

<style>
	.post-card {
		background: var(--color-paper);
		border: 1px solid var(--color-sand-200);
		border-radius: 10px;
		box-shadow: var(--shadow-card);
		transition:
			box-shadow 0.2s ease,
			border-color 0.2s ease;
	}

	.post-card:hover {
		box-shadow: var(--shadow-card-hover);
		border-color: var(--color-sand-300);
	}

	.post-link {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.post-body {
		padding: 1.15rem 1.25rem 1.35rem;
	}

	/* Full bleed to the card's edges, squared off at the bottom where the
	   content meets it. The border radius is one pixel under the card's own so
	   no corner of the image shows outside the border. */
	.post-hero {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 9px 9px 0 0;
		border-bottom: 1px solid var(--color-sand-200);
	}

	/* Inset rather than full bleed: it sits inside the text column, so it lines
	   up with the title above it rather than with the card. */
	.post-video {
		display: block;
		width: 100%;
		height: auto;
		margin-top: 0.85rem;
		border-radius: 8px;
		border: 1px solid var(--color-sand-200);
		background: var(--color-sand-100);
	}



	/* The label, the date and the avatar share one row; the avatar is pushed to
	   the far edge so the two text items stay grouped at the left. */
	.post-meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-ink-muted);
	}

	/* The label and its icon take the link colour, matching "View all" at the
	   top of the column — they name the kind of thing the card is, and reading
	   as the accent rather than as body text keeps that legible at this size.
	   The date beside them stays muted; it is not part of the label. */
	.post-icon {
		flex-shrink: 0;
		color: var(--color-lavender);
	}

	.post-kind {
		color: var(--color-lavender);
	}

	.post-avatar {
		margin-left: auto;
		width: 22px;
		height: 22px;
		border-radius: 50%;
		object-fit: cover;
		border: 1px solid var(--color-sand-200);
		/* Paper behind the line drawing, so the card shows through only where
		   the circle ends rather than through the portrait itself. */
		background: var(--color-paper);
	}

	.post-title {
		margin: 0.85rem 0 0;
		font-size: 1.1875rem;
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: -0.015em;
		color: var(--color-ink);
	}

	.post-link:hover .post-title {
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.post-hook {
		margin: 0.5rem 0 0;
		font-size: 0.875rem;
		line-height: 1.55;
		color: var(--color-ink-soft);
	}
</style>

<script is:inline>
	/*
	 * Autoplay cannot be called off in CSS, so a reduced-motion preference is
	 * honoured here instead: the loop is stopped and the controls are put back,
	 * which leaves the clip watchable rather than removing it. Inline and
	 * unconditional so it runs before the first frame is painted.
	 */
	if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		for (const video of document.querySelectorAll('video[autoplay]')) {
			video.autoplay = false;
			video.controls = true;
			video.pause();
		}
	}
</script>
