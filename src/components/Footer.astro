---
import { SITE_TITLE } from '../consts';
import { getNavHref } from '../lib/nav';

const today = new Date();
---

<footer class="site-footer">
	<div class="footer-inner">
		<p class="copy">&copy; {today.getFullYear()} {SITE_TITLE}</p>

		<nav class="footer-nav" aria-label="Footer">
			<a href={getNavHref('/projects/')}>Projects</a>
			<a href={getNavHref('/about/')}>About</a>
			<a href="https://github.com/maghamis" target="_blank" rel="noopener noreferrer">GitHub</a>
		</nav>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-sand-200);
		/* body is a flex column, so this pins the footer to the bottom
		   of short pages without collapsing the gap on long ones. */
		margin-top: auto;
		padding: 2rem 1.25rem 3rem;
	}

	.footer-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
		max-width: 1160px;
		margin-inline: auto;
	}

	.copy {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-ink-muted);
	}

	.footer-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
	}

	.footer-nav a {
		font-size: 0.8125rem;
		color: var(--color-ink-muted);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.footer-nav a:hover {
		color: var(--color-ink);
	}
</style>
