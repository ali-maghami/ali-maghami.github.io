---
import { badgeImage } from '../lib/badges';
import ExternalLink from './ExternalLink.astro';
import { buildNavItems, getNavHref, showsFooterBadges } from '../lib/nav';
import { getSiteSections } from '../lib/sections';
import { getSiteSettings } from '../lib/portfolio-data';

const today = new Date();
const [{ counts, certificates: allCertificates }, settings] = await Promise.all([
	getSiteSections(),
	getSiteSettings(),
]);
const { siteTitle: SITE_TITLE, social: SOCIAL } = settings;
const FOOTER_BADGE_LIMIT = settings.footerBadges.limit;
const FOOTER_BADGE_PAGES = settings.footerBadges.pages;
const navItems = buildNavItems(counts);

// Three separate switches, all set in the CMS. `featured` on a certificate
// picks *which* are worth showing; footerBadges.pages picks *which pages* show
// them at all, since the footer is on every page; footerBadges.limit caps *how
// many* appear, so marking another certificate featured cannot quietly stretch
// the strip. A limit of 0 means no cap.
const eligible = allCertificates.filter((c) => c.featured);
const featured = (FOOTER_BADGE_LIMIT > 0 ? eligible.slice(0, FOOTER_BADGE_LIMIT) : eligible).map(
	(c) => ({ ...c, badge: badgeImage(c.badge) }),
);
const showBadges = showsFooterBadges(Astro.url.pathname, FOOTER_BADGE_PAGES);
---

<footer class="site-footer">
	{
		showBadges &&
			featured.length > 0 && (
			<div class="cert-strip">
				<div class="cert-inner">
					<p class="cert-label">Certifications</p>
					<ul class="cert-list">
						{featured.map((cert) => {
							const inner = (
								<>
									{cert.badge && (
										<img
											class="cert-badge"
											src={cert.badge}
											alt=""
											width="100"
											height="100"
											loading="lazy"
											decoding="async"
										/>
									)}
									<span class="cert-name">{cert.name}</span>
								</>
							);
							return (
								<li class="cert">
								{cert.url ? (
									<a href={cert.url} target="_blank" rel="noopener noreferrer">
											{inner}
										</a>
									) : (
										<span>{inner}</span>
									)}
								</li>
							);
						})}
					</ul>
					{allCertificates.length > featured.length && (
						<a class="cert-all" href={getNavHref('/certificates/')}>
							All {allCertificates.length} &rarr;
						</a>
					)}
				</div>
			</div>
		)
	}

	<div class="footer-inner">
		<p class="copy">&copy; {today.getFullYear()} {SITE_TITLE}</p>

		<nav class="footer-nav" aria-label="Footer">
			{
				navItems
					.filter((item) => item.href !== '/')
					.map((item) => <a href={getNavHref(item.href)}>{item.label}</a>)
			}
			{allCertificates.length > 0 && <a href={getNavHref('/certificates/')}>Certificates</a>}
			{SOCIAL.github && <ExternalLink href={SOCIAL.github}>GitHub</ExternalLink>}
			{SOCIAL.linkedin && <ExternalLink href={SOCIAL.linkedin}>LinkedIn</ExternalLink>}
			{SOCIAL.scholar && <ExternalLink href={SOCIAL.scholar}>Scholar</ExternalLink>}
			{SOCIAL.email && <a href={`mailto:${SOCIAL.email}`}>Email</a>}
		</nav>
	</div>
</footer>

<style>
	.site-footer {
		position: relative;
		z-index: 1;
		border-top: 1px solid var(--color-sand-200);
		/* body is a flex column, so this pins the footer to the bottom
		   of short pages without collapsing the gap on long ones. */
		margin-top: auto;
	}

	/* Translucent white rather than a fixed sand tone: the page surface changes
	   colour on every load, and a warm panel clashed with the cooler palettes. */
	.cert-strip {
		border-bottom: 1px solid var(--color-sand-200);
		background: rgb(255 255 255 / 45%);
		padding: 1.5rem 1.25rem 1.25rem;
	}

	.cert-inner {
		max-width: 1160px;
		margin-inline: auto;
	}

	.cert-label {
		margin: 0 0 0.9rem;
		text-align: center;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-ink-muted);
	}

	/* Tiles rather than a row: the badge stacks over its name, so a column is
	   only as wide as the badge plus a little, and many fit across one page.
	   Fixed tracks rather than 1fr, so a handful of badges sit centred as a
	   group instead of being stretched across the full width. */
	.cert-list {
		display: grid;
		grid-template-columns: repeat(auto-fit, 124px);
		justify-content: center;
		gap: 1.5rem 1rem;
		margin: 0 0 1rem;
		padding: 0;
		list-style: none;
	}

	.cert a,
	.cert > span {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		text-align: center;
		text-decoration: none;
		color: inherit;
	}

	/* Shown at 100px. Twice that is requested from the image pipeline so it
	   stays sharp on dense screens; Astro will not upscale past the source. */
	.cert-badge {
		width: 100px;
		height: 100px;
		object-fit: contain;
		flex-shrink: 0;
	}

	.cert-name {
		font-size: 0.75rem;
		font-weight: 500;
		line-height: 1.3;
		color: var(--color-ink);
	}

	.cert a:hover .cert-name {
		text-decoration: underline;
	}

	.cert-all {
		display: block;
		text-align: center;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		color: var(--color-ink-muted);
		text-decoration: none;
		white-space: nowrap;
	}

	.cert-all:hover {
		color: var(--color-ink);
	}

	.footer-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
		max-width: 1160px;
		margin-inline: auto;
		padding: 2rem 1.25rem 3rem;
	}

	.copy {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-ink-muted);
	}

	.footer-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
	}

	/* :global because the external links are rendered by ExternalLink, and
	   Astro's scoping does not reach into a child component — without it those
	   three would fall back to default link styling while their neighbours
	   stayed small and muted. Confined to .footer-nav, so nothing leaks. */
	.footer-nav :global(a) {
		font-size: 0.8125rem;
		color: var(--color-ink-muted);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.footer-nav :global(a:hover) {
		color: var(--color-ink);
	}

	@media (max-width: 720px) {
		.cert-list {
			grid-template-columns: repeat(auto-fit, 96px);
			gap: 1.25rem 0.75rem;
		}

		.cert-badge {
			width: 72px;
			height: 72px;
		}
	}
</style>
