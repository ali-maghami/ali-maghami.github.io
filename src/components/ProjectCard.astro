---
import FormattedDate from './FormattedDate.astro';
import GenericAvatar from './GenericAvatar.astro';
import { cardGradient } from '../lib/cards';
import { stageLabel } from '../lib/projects';

interface Props {
	href: string;
	stage: string;
	title: string;
	description?: string;
	date: Date;
	cardColor: string;
	cardColorAlt?: string;
	avatar?: string;
	/** Anyone credited besides the site owner. Names are not shown here. */
	contributors?: string[];
}

const {
	href,
	stage,
	title,
	description,
	date,
	cardColor,
	cardColorAlt,
	avatar,
	contributors = [],
} = Astro.props;

// Stored per project rather than derived from the page palette, so a card keeps
// the same colour on every visit.
const wash = cardGradient(cardColor, cardColorAlt);
---

<article class="project-card" style={`--card-wash:${wash}`}>
	<a class="project-link" href={href}>
		<div class="project-meta">
			<FormattedDate date={date} precision="monthYear" />
			<span class="project-label">{stageLabel(stage)}</span>
		</div>

		<div class="project-body">
			<h3 class="project-title">{title}</h3>
			{description && <p class="project-desc">{description}</p>}
			{
				avatar && (
					<div class="project-people">
						<img src={avatar} alt="" width="52" height="52" loading="lazy" />
						{/*
						 * One stand-in per additional contributor, so the card
						 * shows at a glance how many people worked on it. Names
						 * belong on the project page, not here — a card has no
						 * room for them, and the count is the useful part.
						 */}
						{contributors.map(() => (
							<GenericAvatar />
						))}
						{contributors.length > 0 && (
							<span class="sr-only">
								{`and ${contributors.length} other ${
									contributors.length === 1 ? 'contributor' : 'contributors'
								}`}
							</span>
						)}
					</div>
				)
			}
		</div>
	</a>
</article>

<style>
	.project-card {
		position: relative;
		border: 1px solid var(--color-sand-200);
		border-radius: 12px;
		/* The wash sits over the card's own surface, so the faded corner lands
		   on paper rather than on whatever the page background happens to be. */
		background: var(--card-wash, none), var(--color-paper);
		box-shadow: var(--shadow-card);
		overflow: hidden;
		transition:
			box-shadow 0.2s ease,
			border-color 0.2s ease;
	}

	.project-card:hover {
		box-shadow: var(--shadow-card-hover);
		border-color: var(--color-sand-300);
	}

	.project-link {
		display: flex;
		flex-direction: column;
		/* Tall enough that the wash has room to fall off across the card, which
		   is the whole point of anchoring it in the corner. */
		min-height: 290px;
		padding: 1.15rem 1.35rem 1.35rem;
		color: inherit;
		text-decoration: none;
	}

	.project-meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-ink-muted);
	}

	/* The bubble the label sits in. Now that the wash is confined to the
	   corner, the label usually sits on paper rather than on colour, so a
	   translucent white fill was invisible. A neutral tint with a hairline
	   reads on both — and matches the tag chips used elsewhere. */
	.project-label {
		background: var(--color-sand-100);
		border: 1px solid var(--color-sand-200);
		border-radius: 999px;
		padding: 0.25rem 0.65rem;
		color: var(--color-ink-soft);
	}

	/* Pushed to the bottom, leaving the wash uninterrupted at the top. */
	.project-body {
		margin-top: auto;
		padding-top: 2.5rem;
	}

	.project-title {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: -0.02em;
		color: var(--color-ink);
	}

	.project-link:hover .project-title {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.project-desc {
		margin: 0.6rem 0 0;
		font-size: 0.9375rem;
		line-height: 1.5;
		color: var(--color-ink-soft);
	}

	.project-people {
		display: flex;
		align-items: center;
		margin-top: 1rem;
	}

	.project-people img,
	.project-people :global(.avatar) {
		width: 26px;
		height: 26px;
		flex-shrink: 0;
		border-radius: 50%;
		object-fit: cover;
		/* Two rings, doing different jobs. The paper border is what separates
		   overlapping avatars from each other; on its own it is invisible
		   against a white card, so a hairline outside it gives the circle an
		   edge to read against. */
		border: 2px solid var(--color-paper);
		box-shadow: 0 0 0 1px var(--color-sand-300);
	}

	/* Overlapped rather than spaced, so a long list stays compact and reads as
	   one group. Each circle sits under the one before it, which keeps the
	   owner's photograph on top and fully visible.

	   :global because the stand-ins are a child component and carry its scope
	   id, not this one's — a scoped selector here would match the owner's
	   <img> and silently skip every avatar beside it. */
	.project-people > :global(:not(:first-child)) {
		margin-left: -9px;
	}

	.project-people img {
		position: relative;
		z-index: 1;
	}

	@media (max-width: 720px) {
		.project-link {
			min-height: 240px;
		}
		.project-title {
			font-size: 1.3125rem;
		}
	}
</style>
