---
/*
 * A link that leaves the site, marked with an arrow so that is visible before
 * it is clicked.
 *
 * The arrow is aria-hidden and paired with real text, because a screen reader
 * announcing "north east arrow" tells nobody anything, while the sighted cue
 * on its own leaves everyone else to discover the new tab by surprise.
 */
interface Props {
	href: string;
	class?: string;
}

const { href, class: className } = Astro.props;
---

<a href={href} class={className} target="_blank" rel="noopener noreferrer">
	<slot /><span class="ext" aria-hidden="true">↗</span><span class="sr-only">
		(opens in a new tab)</span
	>
</a>

<style>
	a {
		/* Keeps the arrow on the same line as the last word of the label. */
		white-space: nowrap;
	}
</style>
