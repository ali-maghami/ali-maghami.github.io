---
import { getNavHref } from '../lib/nav';
import { getSiteSettings } from '../lib/portfolio-data';
import { getNavItems } from '../lib/sections';
import HeaderLink from './HeaderLink.astro';

const [navItems, settings] = await Promise.all([getNavItems(), getSiteSettings()]);
const { siteTitle: SITE_TITLE, social: SOCIAL } = settings;
---

<header class="site-header">
	{/* Invisible until focused: lets a keyboard reader jump past the nav. */}
	<a class="skip-link" href="#main">Skip to content</a>
	<nav class="nav-inner" aria-label="Main">
		<a class="brand" href={getNavHref('/')}>{SITE_TITLE}</a>

		<div class="nav-pill" data-nav>
			<span class="nav-indicator" data-nav-indicator aria-hidden="true"></span>
			{navItems.map((item) => <HeaderLink href={getNavHref(item.href)}>{item.label}</HeaderLink>)}
		</div>

		<div class="social-links">
			{SOCIAL.github && (
			<a href={SOCIAL.github} target="_blank" rel="noopener noreferrer">
				<span class="sr-only">GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
			)}
			{
				SOCIAL.linkedin && (
					<a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer">
						<span class="sr-only">LinkedIn</span>
						<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18">
							<path
								fill="currentColor"
								d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146Zm4.943 12.248V6.169H2.542v7.225h2.401Zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016Zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4Z"
							/>
						</svg>
					</a>
				)
			}
			{
				SOCIAL.scholar && (
					<a href={SOCIAL.scholar} target="_blank" rel="noopener noreferrer">
						<span class="sr-only">Google Scholar</span>
						<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18">
							<path fill="currentColor" d="M8 0 0 5.6l8 5.6 8-5.6L8 0Z" />
							<path
								fill="currentColor"
								d="M3.2 8.24v2.72c0 1.5 2.15 2.72 4.8 2.72s4.8-1.22 4.8-2.72V8.24L8 11.66 3.2 8.24Z"
							/>
						</svg>
					</a>
				)
			}
			{
				SOCIAL.email && (
					<a href={`mailto:${SOCIAL.email}`}>
						<span class="sr-only">Email</span>
						<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18">
							<path
								fill="currentColor"
								d="M1.5 2.5h13A1.5 1.5 0 0 1 16 4v8a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 0 12V4a1.5 1.5 0 0 1 1.5-1.5Zm0 1a.5.5 0 0 0-.5.5v.23l7 4.2 7-4.2V4a.5.5 0 0 0-.5-.5h-13ZM15 5.4 8.26 9.44a.5.5 0 0 1-.52 0L1 5.4V12a.5.5 0 0 0 .5.5h13a.5.5 0 0 0 .5-.5V5.4Z"
							/>
						</svg>
					</a>
				)
			}
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: relative;
		z-index: 20;
		padding: 1rem 1.25rem;
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: 1160px;
		margin-inline: auto;
	}

	.brand {
		flex-shrink: 0;
		font-size: 1.4rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--color-ink);
		text-decoration: none;
	}

	.brand:hover {
		color: var(--color-ink-soft);
	}

	/* The floating, frosted pill that holds the nav links. */
	.nav-pill {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.125rem;
		padding: 0.25rem;
		border-radius: 999px;
		background: rgb(255 255 255 / 55%);
		border: 1px solid rgb(255 255 255 / 45%);
		box-shadow:
			0 1px 2px rgb(48 48 38 / 4%),
			0 4px 14px rgb(48 48 38 / 6%);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		max-width: 100%;
		overflow-x: auto;
		scrollbar-width: none;
	}

	.nav-pill::-webkit-scrollbar {
		display: none;
	}

	/* Slides behind whichever link is active or hovered. */
	.nav-indicator {
		position: absolute;
		top: 0.25rem;
		left: 0;
		height: calc(100% - 0.5rem);
		width: 0;
		border-radius: 999px;
		background: var(--color-paper);
		box-shadow: 0 1px 2px rgb(48 48 38 / 8%);
		opacity: 0;
		pointer-events: none;
		transform: translateX(0);
		transition:
			transform 0.25s cubic-bezier(0.32, 0.72, 0, 1),
			width 0.25s cubic-bezier(0.32, 0.72, 0, 1),
			opacity 0.2s ease;
	}

	.social-links {
		flex-shrink: 0;
		display: flex;
		gap: 0.85rem;
		color: var(--color-ink-muted);
	}

	.social-links a {
		display: flex;
		color: inherit;
		transition: color 0.2s ease;
	}

	.social-links a:hover {
		color: var(--color-ink);
	}

	@media (max-width: 720px) {
		.site-header {
			padding: 0.85rem 1rem;
		}

		.nav-inner {
			flex-wrap: wrap;
			justify-content: center;
			gap: 0.75rem;
		}

		.brand {
			flex: 1 1 auto;
		}

		.nav-pill {
			order: 3;
			flex: 1 1 100%;
			justify-content: flex-start;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.nav-indicator {
			transition: none;
		}
	}
</style>

<script>
	function setUpNavIndicator() {
		const nav = document.querySelector<HTMLElement>('[data-nav]');
		const indicator = document.querySelector<HTMLElement>('[data-nav-indicator]');
		if (!nav || !indicator) return;

		const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a'));
		const active = links.find((link) => link.classList.contains('active'));

		const moveTo = (target: HTMLElement | undefined) => {
			if (!target) {
				indicator.style.opacity = '0';
				return;
			}
			indicator.style.opacity = '1';
			indicator.style.width = `${target.offsetWidth}px`;
			indicator.style.transform = `translateX(${target.offsetLeft}px)`;
		};

		moveTo(active);

		// The pill is sized from the link's measured width, and the heading
		// typeface loads after first paint — so the first measurement is of
		// fallback text and the pill ends up a few pixels narrow. Re-measuring
		// once the fonts have settled corrects it.
		document.fonts?.ready.then(() => moveTo(active));

		links.forEach((link) => {
			link.addEventListener('mouseenter', () => moveTo(link));
			link.addEventListener('focus', () => moveTo(link));
		});
		nav.addEventListener('mouseleave', () => moveTo(active));
		nav.addEventListener('focusout', () => moveTo(active));
		window.addEventListener('resize', () => moveTo(active));
	}

	setUpNavIndicator();
	document.addEventListener('astro:page-load', setUpNavIndicator);
</script>
