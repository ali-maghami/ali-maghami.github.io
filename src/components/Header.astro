---
import { SITE_TITLE } from '../consts';
import { getNavHref } from '../lib/nav';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav class="nav-inner" aria-label="Main">
		<a class="brand" href={getNavHref('/')}>{SITE_TITLE}</a>

		<div class="nav-pill" data-nav>
			<span class="nav-indicator" data-nav-indicator aria-hidden="true"></span>
			<HeaderLink href={getNavHref('/')}>Home</HeaderLink>
			<HeaderLink href={getNavHref('/projects/')}>Projects</HeaderLink>
			<HeaderLink href={getNavHref('/about/')}>About</HeaderLink>
		</div>

		<div class="social-links">
			<a href="https://github.com/maghamis" target="_blank" rel="noopener noreferrer">
				<span class="sr-only">GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: relative;
		z-index: 20;
		padding: 1rem 1.25rem;
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: 1160px;
		margin-inline: auto;
	}

	.brand {
		flex-shrink: 0;
		font-size: 0.9375rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--color-ink);
		text-decoration: none;
	}

	.brand:hover {
		color: var(--color-ink-soft);
	}

	/* The floating, frosted pill that holds the nav links. */
	.nav-pill {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.125rem;
		padding: 0.25rem;
		border-radius: 999px;
		background: rgb(255 255 255 / 55%);
		border: 1px solid rgb(255 255 255 / 45%);
		box-shadow:
			0 1px 2px rgb(48 48 38 / 4%),
			0 4px 14px rgb(48 48 38 / 6%);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		max-width: 100%;
		overflow-x: auto;
		scrollbar-width: none;
	}

	.nav-pill::-webkit-scrollbar {
		display: none;
	}

	/* Slides behind whichever link is active or hovered. */
	.nav-indicator {
		position: absolute;
		top: 0.25rem;
		left: 0;
		height: calc(100% - 0.5rem);
		width: 0;
		border-radius: 999px;
		background: var(--color-paper);
		box-shadow: 0 1px 2px rgb(48 48 38 / 8%);
		opacity: 0;
		pointer-events: none;
		transform: translateX(0);
		transition:
			transform 0.25s cubic-bezier(0.32, 0.72, 0, 1),
			width 0.25s cubic-bezier(0.32, 0.72, 0, 1),
			opacity 0.2s ease;
	}

	.social-links {
		flex-shrink: 0;
		display: flex;
		gap: 0.85rem;
		color: var(--color-ink-muted);
	}

	.social-links a {
		display: flex;
		color: inherit;
		transition: color 0.2s ease;
	}

	.social-links a:hover {
		color: var(--color-ink);
	}

	@media (max-width: 720px) {
		.site-header {
			padding: 0.85rem 1rem;
		}

		.nav-inner {
			flex-wrap: wrap;
			justify-content: center;
			gap: 0.75rem;
		}

		.brand {
			flex: 1 1 auto;
		}

		.nav-pill {
			order: 3;
			flex: 1 1 100%;
			justify-content: flex-start;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.nav-indicator {
			transition: none;
		}
	}
</style>

<script>
	function setUpNavIndicator() {
		const nav = document.querySelector<HTMLElement>('[data-nav]');
		const indicator = document.querySelector<HTMLElement>('[data-nav-indicator]');
		if (!nav || !indicator) return;

		const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a'));
		const active = links.find((link) => link.classList.contains('active'));

		const moveTo = (target: HTMLElement | undefined) => {
			if (!target) {
				indicator.style.opacity = '0';
				return;
			}
			indicator.style.opacity = '1';
			indicator.style.width = `${target.offsetWidth}px`;
			indicator.style.transform = `translateX(${target.offsetLeft}px)`;
		};

		moveTo(active);

		links.forEach((link) => {
			link.addEventListener('mouseenter', () => moveTo(link));
			link.addEventListener('focus', () => moveTo(link));
		});
		nav.addEventListener('mouseleave', () => moveTo(active));
		nav.addEventListener('focusout', () => moveTo(active));
		window.addEventListener('resize', () => moveTo(active));
	}

	setUpNavIndicator();
	document.addEventListener('astro:page-load', setUpNavIndicator);
</script>
