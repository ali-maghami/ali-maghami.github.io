---
/*
 * The AM mark, in one colour.
 *
 * Inline rather than an <img> so it takes `currentColor`: the footer needs it
 * in muted ink, and the dark scheme flips that without a second asset. The
 * paths are Ali's flat drawing of the mark (src/brand/am-flat-logo.svg), which
 * matches the gradient artwork's outline closely enough that nobody could tell
 * at the size this appears — and unlike the artwork, it is a vector.
 *
 * Decorative wherever it sits beside the name it stands for, which is why it
 * is hidden from assistive technology by default.
 */
interface Props {
	class?: string;
	/** A label, when the mark stands alone and has to name itself. */
	label?: string;
}

const { class: className, label } = Astro.props;
---

<svg
	class:list={['monogram', className]}
	viewBox="25 153 1362 729"
	fill="currentColor"
	role={label ? 'img' : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : 'true'}
>
	<path d="M 1243,173 L 1206,182 L 1174,201 L 874,524 L 1000,699 L 1146,532 L 1147,803 L 1156,829 L 1171,846 L 1195,857 L 1312,858 L 1332,852 L 1350,838 L 1361,820 L 1365,804 L 1365,266 L 1361,246 L 1353,227 L 1339,207 L 1327,196 L 1294,178 L 1269,173 Z"></path>
	<path d="M 411,275 L 399,270 L 381,269 L 363,275 L 348,286 L 72,736 L 48,782 L 45,809 L 55,835 L 73,851 L 91,858 L 226,859 L 242,852 L 264,825 L 511,416 L 516,423 L 429,291 Z"></path>
	<path d="M 742,344 L 746,349 L 745,761 L 737,749 L 806,846 L 826,857 L 851,858 L 870,850 L 884,837 L 1008,693 L 1001,701 L 872,524 L 880,516 L 871,522 Z"></path>
	<path d="M 429,188 L 399,214 L 352,282 L 371,270 L 394,268 L 411,274 L 430,291 L 745,760 L 745,349 L 650,211 L 637,197 L 620,185 L 599,176 L 582,173 L 475,173 L 457,176 Z"></path>
	<path d="M 502,618 L 480,622 L 456,632 L 441,641 L 422,659 L 408,680 L 397,706 L 393,747 L 404,788 L 415,808 L 434,830 L 457,846 L 487,858 L 526,860 L 544,857 L 569,847 L 586,836 L 606,817 L 617,801 L 630,770 L 634,749 L 634,724 L 630,702 L 621,679 L 605,655 L 594,645 L 558,625 L 534,619 Z"></path>
</svg>

<style>
	.monogram {
		display: block;
		width: auto;
		/* Height drives it: the mark is wider than it is tall, and what has to
		   line up with neighbouring text is its height. */
		height: 1em;
		flex-shrink: 0;
	}
</style>
