---
/*
 * Slowly drifting colour wash across the top of every page — a CSS stand-in
 * for the animated gradient canvas on githubnext.com.
 *
 * Rendered once per page as the first element in <body>, absolutely positioned
 * so it scrolls away with the content and masked to nothing before the page
 * gets to its body text. Layout sits above it via the z-index rules in
 * global.css, so it never intercepts a click or covers a heading.
 *
 * The four blob colours come from --accent-1..4, set by the section palette on
 * <html> (see lib/palettes.ts). The theme tokens remain as fallbacks for a
 * page without one.
 */
---

<div class="aurora" aria-hidden="true">
	<span class="blob blob-1"></span>
	<span class="blob blob-2"></span>
	<span class="blob blob-3"></span>
	<span class="blob blob-4"></span>
	<span class="grain"></span>
</div>

<style>
	.aurora {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		/* Tall enough to colour the masthead and the top of the content on any
		   page, short enough that long pages return to plain surface. */
		height: 62vh;
		min-height: 420px;
		z-index: 0;
		overflow: hidden;
		pointer-events: none;
		mask-image: linear-gradient(to bottom, black 42%, transparent 100%);
		-webkit-mask-image: linear-gradient(to bottom, black 42%, transparent 100%);
	}

	.blob {
		position: absolute;
		border-radius: 50%;
		filter: blur(90px);
		/* Saturated rather than washed out — the colours are the point. */
		opacity: calc(0.85 * var(--aurora-strength, 1));
		will-change: transform;
	}

	.blob-1 {
		width: 42vw;
		height: 42vw;
		min-width: 320px;
		min-height: 320px;
		top: -22%;
		left: -6%;
		background: var(--accent-1, var(--color-sky));
		animation: drift-1 26s ease-in-out infinite alternate;
	}

	.blob-2 {
		width: 34vw;
		height: 34vw;
		min-width: 260px;
		min-height: 260px;
		top: -10%;
		right: -4%;
		background: var(--accent-2, var(--color-banana));
		opacity: calc(0.75 * var(--aurora-strength, 1));
		animation: drift-2 32s ease-in-out infinite alternate;
	}

	.blob-3 {
		width: 30vw;
		height: 30vw;
		min-width: 240px;
		min-height: 240px;
		bottom: -26%;
		left: 24%;
		background: var(--accent-3, var(--color-mint));
		opacity: calc(0.8 * var(--aurora-strength, 1));
		animation: drift-3 24s ease-in-out infinite alternate;
	}

	/* Reaches up behind the nav pill rather than starting below it, so the
	   masthead sits in colour instead of on bare surface. It already spans the
	   pill horizontally, so only the top edge moves. */
	.blob-4 {
		width: 28vw;
		height: 28vw;
		min-width: 240px;
		min-height: 240px;
		top: -8%;
		left: 38%;
		background: var(--accent-4, var(--color-copper-warm));
		opacity: calc(0.6 * var(--aurora-strength, 1));
		animation: drift-2 29s ease-in-out infinite alternate-reverse;
	}

	/* A whisper of texture so the wash reads as paper, not as a screen. */
	.grain {
		position: absolute;
		inset: 0;
		background-image: radial-gradient(
			circle at 1px 1px,
			rgb(var(--shadow-rgb) / 10%) 1px,
			transparent 0
		);
		background-size: 4px 4px;
		opacity: 0.07;
	}

	@keyframes drift-1 {
		from {
			transform: translate3d(0, 0, 0) scale(1);
		}
		to {
			transform: translate3d(6%, 8%, 0) scale(1.12);
		}
	}

	@keyframes drift-2 {
		from {
			transform: translate3d(0, 0, 0) scale(1.05);
		}
		to {
			transform: translate3d(-8%, 6%, 0) scale(0.95);
		}
	}

	@keyframes drift-3 {
		from {
			transform: translate3d(0, 0, 0) scale(0.95);
		}
		to {
			transform: translate3d(10%, -6%, 0) scale(1.1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.blob {
			animation: none;
		}
	}
</style>
