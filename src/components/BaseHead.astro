---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { Font } from 'astro:assets';
import BackgroundPalette from './BackgroundPalette.astro';
import { publicImageSize } from '../lib/images';
import { getSiteSettings } from '../lib/portfolio-data';

interface Props {
	title: string;
	description: string;
	/**
	 * The image a share of this page shows: a path in public/ or an absolute
	 * URL. Pages without one get the site card, so no share is ever a bare
	 * text box.
	 */
	image?: string;
	imageAlt?: string;
	/** Posts and project write-ups are articles; everything else is the site. */
	type?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
}

/**
 * The site card, 1200×630, shown when a page has no image of its own. A
 * committed asset rather than CMS content: it is the brand, and a share
 * should look the same whatever the home page says this week.
 */
const DEFAULT_IMAGE = '/og/default.jpg';
const DEFAULT_IMAGE_SIZE = { width: 1200, height: 630 };

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image,
	imageAlt,
	type = 'website',
	publishedTime,
	modifiedTime,
} = Astro.props;

const settings = await getSiteSettings();

const imageURL = new URL(image ?? DEFAULT_IMAGE, canonicalURL);
const imageSize = image ? await publicImageSize(image) : DEFAULT_IMAGE_SIZE;
const imageDescription = imageAlt ?? (image ? title : `${settings.siteTitle}: ${settings.siteDescription}`);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#f6f7ee" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap.xml" />
<!-- Feed readers look for this on any page, not just /blog/. -->
<link rel="alternate" type="application/rss+xml" title={settings.siteTitle} href="/rss.xml" />
<meta name="generator" content={Astro.generator} />

<BackgroundPalette />

<Font cssVariable="--font-mona" preload />
<Font cssVariable="--font-jetbrains" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={settings.siteTitle} />

<!-- Open Graph / Facebook / LinkedIn -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={settings.siteTitle} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
{imageSize && <meta property="og:image:width" content={String(imageSize.width)} />}
{imageSize && <meta property="og:image:height" content={String(imageSize.height)} />}
<meta property="og:image:alt" content={imageDescription} />
{
	type === 'article' && (
		<>
			{publishedTime && (
				<meta property="article:published_time" content={publishedTime.toISOString()} />
			)}
			{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
			<meta property="article:author" content={new URL('/about/', Astro.site)} />
		</>
	)
}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={imageDescription} />
