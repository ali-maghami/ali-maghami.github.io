---
import { resizedImage } from '../lib/images';
import { getNavHref } from '../lib/nav';

/*
 * Who wrote this, at the end of a post. A reader who arrived from a share has
 * read the whole piece without being told whose site they are on; this says
 * so once, where they have just finished reading, and offers the two places
 * to go next.
 */
interface Props {
	name: string;
	line?: string;
	portrait?: string;
}

const { name, line, portrait } = Astro.props;
---

<aside class="author" aria-label="About the author">
	{portrait && <img src={resizedImage(portrait, 104)} alt="" width="52" height="52" loading="lazy" />}
	<div class="who">
		<p class="name">Written by {name}</p>
		{line && <p class="line">{line}</p>}
		<p class="links">
			<a href={getNavHref('/about/')}>About</a>
			<a href={getNavHref('/blog/')}>More posts</a>
			<a href="/rss.xml">RSS</a>
		</p>
	</div>
</aside>

<style>
	.author {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1.15rem 1.25rem;
		background: var(--color-paper);
		border: 1px solid var(--color-sand-200);
		border-radius: 12px;
		box-shadow: var(--shadow-card);
	}

	img {
		flex-shrink: 0;
		width: 52px;
		height: 52px;
		border-radius: 50%;
		object-fit: cover;
		border: 2px solid var(--color-paper);
		box-shadow: 0 0 0 1px var(--color-sand-300);
		background: var(--color-paper);
	}

	.who {
		min-width: 0;
	}

	.name {
		margin: 0;
		font-weight: 600;
		color: var(--color-ink);
	}

	.line {
		margin: 0.15rem 0 0;
		font-size: 0.9375rem;
		color: var(--color-ink-soft);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem;
		margin: 0.55rem 0 0;
		font-size: 0.8125rem;
		font-weight: 500;
	}

	.links a {
		text-decoration: none;
	}

	.links a:hover {
		text-decoration: underline;
	}
</style>
