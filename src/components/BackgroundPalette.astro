---
import { PALETTES } from '../lib/palettes';

/*
 * Picks one of the background palettes on every page load, the way
 * githubnext.com recolours itself on each visit.
 *
 * This runs as a blocking inline script in <head> rather than as a module,
 * because it has to set the custom properties before the first paint — a
 * deferred script would show the default palette and then visibly repaint.
 * The CSS carries the default values as fallbacks, so a visitor with no
 * JavaScript still gets the site's normal paper tone rather than an
 * unstyled page.
 */
const surfaces = PALETTES.map((p) => p.surface);
const accents = PALETTES.map((p) => p.accents);
---

<script is:inline define:vars={{ surfaces, accents }}>
	(() => {
		const count = surfaces.length;
		if (!count) return;

		// Remembering the last pick keeps a refresh from landing on the same
		// palette twice, which would read as "the feature is broken". Storage
		// throws in some privacy modes, so every access is guarded.
		let previous = null;
		try {
			const stored = window.sessionStorage.getItem('palette');
			if (stored !== null) previous = Number.parseInt(stored, 10);
		} catch {
			/* no storage: fall through to an unconstrained pick */
		}

		if (!Number.isInteger(previous) || previous < 0 || previous >= count) {
			previous = null;
		}

		let index;
		if (count === 1) {
			index = 0;
		} else if (previous === null) {
			index = Math.floor(Math.random() * count) % count;
		} else {
			const offset = Math.floor(Math.random() * (count - 1)) % (count - 1);
			index = offset >= previous ? offset + 1 : offset;
		}

		const root = document.documentElement;
		root.style.setProperty('--surface', surfaces[index]);
		accents[index].forEach((colour, i) => {
			root.style.setProperty(`--accent-${i + 1}`, colour);
		});

		// Keep the mobile browser chrome in step with the page.
		const themeColor = document.querySelector('meta[name="theme-color"]');
		if (themeColor) themeColor.setAttribute('content', surfaces[index]);

		try {
			window.sessionStorage.setItem('palette', String(index));
		} catch {
			/* not being able to remember only costs us a possible repeat */
		}
	})();
</script>
