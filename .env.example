# Read-only role generated by portfolio-cms/scripts/provision-database.sh.
# Production stores the real value in /home/ali/apps/portfolio/.env.reader.
PORTFOLIO_DATABASE_URL=postgres://portfolio_reader:REPLACE_ME@postgres:5432/portfolio

# Shared with the CMS, which signs draft preview links with it. Unset, previews
# are simply off — an unsigned request still sees only published entries.
# Generate with: openssl rand -base64 32
PREVIEW_SECRET=
